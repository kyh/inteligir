{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".design-sync/**"],
  // The `packages/*` workspaces publish each source file as its own subpath
  // export (some through a `./*` wildcard), so knip reads EVERY file as an
  // entry — and knip's default is to trust an entry's exports as the public
  // API, which turns unused-export reporting off for the whole package. Each
  // workspace below states which side of that trade it is on, and why.
  "workspaces": {
    ".": {},
    "apps/web": {
      // The Worker entry (src/worker/server.ts) is not listed: knip reads it
      // from wrangler.jsonc's `main`. `src/worker/index.ts` is the test suite's
      // entry (vitest.config `main`), which no plugin resolves.
      "entry": ["src/routes/**/*.tsx", "src/worker/index.ts", "src/worker/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // `cloudflare` is NOT a stale suppression, and NOT an npm package:
      // `cloudflare:workers` and `cloudflare:test` are workerd /
      // vitest-pool-workers BUILT-IN module specifiers. knip reads the
      // `cloudflare:` scheme prefix as a package name and reports them as
      // "unlisted dependencies". Removing it turns the gate red; installing a
      // `cloudflare` package would be worse.
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    // Carried ahead of its v3 consumers (issue #542): the package's public
    // surface is deliberately wider than today's importers, so its entry
    // exports are trusted as API rather than reported. Flip this back to
    // `includeEntryExports: true` once the v3 features consume it in-repo.
    "packages/notes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // The ONE package that keeps knip's default `includeEntryExports: false`,
    // and the reason is the package rather than the findings. `src/components`
    // is VENDORED shadcn: each file is copied from the registry, recorded in
    // components.provenance.json, and re-pullable with one command — so its
    // exports are the UPSTREAM component's surface, not this repo's. Deleting
    // `DialogClose` because nothing calls it today makes the next re-pull a
    // conflict and the provenance record a lie.
    //
    // The invariant that actually has teeth here is coarser and lives as a
    // test: src/__tests__/no-orphan-components.test.ts fails when a whole
    // component file has no consumer (a real failure knip cannot see either,
    // since the `./components/*` wildcard export makes every file an entry).
    // Turning this on would only ever report members of files that guard
    // already proves are in use.
    "packages/ui": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": false
    }
  }
}
