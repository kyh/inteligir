{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // packages/* export every file as a subpath, so knip reads each as an entry and trusts its
  // exports; includeEntryExports turns reporting back on where the exports are not the API
  "workspaces": {
    ".": {},
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.test.ts",
        "src/desktop/desktop-entry.ts",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"],
      // bin/inteligir runs the source under tsx in a checkout, resolving it, never importing it
      "ignoreDependencies": ["tsx"]
    },
    "apps/desktop": {
      "entry": [
        "scripts/*.{mjs,cjs}",
        "src/renderer/routes/**/*.tsx",
        "src/**/__tests__/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.{mjs,cjs}"],
      "ignore": ["src/renderer/routeTree.gen.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,js}"],
      // linked natively; knip's expo plugin counts it only while `updates` is on, and app.config.js
      // leaves it off until the EAS project is committed
      "ignoreDependencies": ["expo-updates"]
    },
    "apps/web": {
      // gallery-main is gallery.html's script, which knip's vite plugin reads only from index.html
      "entry": [
        "cloudflare.config.ts",
        "src/routes/**/*.tsx",
        "src/components/gallery/gallery-main.tsx",
        "src/worker/index.ts",
        "src/worker/__tests__/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      // `cloudflare:` is a workerd built-in module scheme, not a package
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    "packages/domain": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/contract": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/e2e": {
      // spawned by path from cloud-worker.ts
      "entry": ["src/harness/worker-host.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/repo-guards": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    }
  }
}
