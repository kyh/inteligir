{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // packages/* export every file as a subpath, so knip reads each as an entry and trusts its
  // exports; includeEntryExports turns reporting back on where the exports are not the API
  "workspaces": {
    ".": {},
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.test.{ts,tsx}",
        "src/desktop/desktop-entry.ts",
        "src/server/vault/watcher/parcel-child-entry.ts",
        "src/server/knowledge/projection-worker.ts",
        "scripts/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      // the ACP adapters are resolved with require from the running bundle, never imported
      "ignoreDependencies": [
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp"
      ],
      // the vault service's suite makes a named pipe with the system's own mkfifo, which no
      // package provides
      "ignoreBinaries": ["mkfifo"]
    },
    "apps/desktop": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"],
      // a build output and a dev server, never a module: src-tauri/tauri.conf.json embeds its
      // first-run page and runs its Vite under `tauri dev`
      "ignoreDependencies": ["@repo/workspace"]
    },
    "apps/workspace": {
      // the first-run page is a build of its own (vite.config.ts), and first-run.html's script is
      // read by knip's vite plugin only from index.html
      "entry": [
        "scripts/*.ts",
        "src/first-run/first-run-main.tsx",
        "src/routes/**/*.tsx",
        "src/**/__tests__/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile": {
      // expo reads fingerprint.config.js by its name when it fingerprints the native build
      "entry": ["src/app/**/*.tsx", "src/**/__tests__/**/*.test.ts", "fingerprint.config.js"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,js}"],
      // linked natively; knip's expo plugin counts it only while `updates` is on, and app.config.js
      // leaves it off until the EAS project is committed
      "ignoreDependencies": ["expo-updates"]
    },
    "apps/mobile-editor": {
      "entry": ["src/**/__tests__/**/*.test.{ts,tsx}", "vite/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "vite/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "cloudflare.config.ts",
        "src/routes/**/*.tsx",
        "src/worker/index.ts",
        "src/worker/__tests__/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignore": ["src/worker/types/durable-git.d.ts"],
      // `cloudflare:` is a workerd built-in module scheme, not a package
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    "packages/notes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/editor": {
      "entry": ["src/**/__tests__/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/domain": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/agent-runtime": {
      // the fake vendors are spawned by path, never imported
      "entry": ["src/**/__tests__/**/*.test.ts", "src/test-support/*.mjs", "scripts/*.ts"],
      "project": ["src/**/*.{ts,mjs}", "scripts/*.ts"]
    },
    "packages/contract": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/e2e": {
      // spawned by path from cloud-worker.ts
      "entry": ["src/harness/worker-host.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/ui-gallery": {
      // the entry is index.html's script, which knip's vite plugin reads
      "project": ["src/**/*.{tsx,css}"]
    },
    "tools/repo-guards": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    }
  }
}
