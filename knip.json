{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    "apps/desktop": { "entry": ["scripts/*.ts"] },
    // linked natively; knip's expo plugin counts it only while app.config.js turns `updates` on
    "apps/mobile": { "ignoreDependencies": ["expo-updates"] },
    "apps/extension": {
      "wxt": { "entry": ["src/entrypoints/*.ts", "src/entrypoints/*/main.tsx"] },
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/web": {
      // a module worker is reached by `new URL(…, import.meta.url)`, which knip does not follow
      "entry": [
        "cloudflare.config.ts",
        "src/worker/*.test-d.ts",
        "src/library/import/import-worker.ts"
      ],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/db": {
      // the local D1's config throws on load until `pnpm dev:web` has made that database, so its
      // schema, which drizzle-kit reads, is named here
      "ignore": ["drizzle.config.local.ts"],
      "drizzle": { "config": ["drizzle.config.ts"], "entry": ["src/d1/schema.ts"] }
    },
    "packages/service": {
      "entry": ["cloudflare.config.ts", "src/**/*.test-d.ts"],
      "ignore": ["src/types/highlight-js.d.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
