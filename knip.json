{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // knip's plugins (vitest, vite, TanStack Router, expo-router, package.json scripts) find the
  // tests, routes and scripts, so an entry here is a file none of them can see. A `project` glob
  // stays only where it names CSS, which knip's default project leaves out.
  // packages/* export every file as a subpath, so knip reads each as an entry and trusts its
  // exports; includeEntryExports turns reporting back on where the exports are not the API
  "workspaces": {
    "apps/desktop": {
      // the isolation app's hook, which Tauri inlines into the frame every message to the shell
      // passes through (src-tauri/tauri.conf.json's `pattern`)
      "entry": ["scripts/*.ts", "isolation/index.js"],
      // a build output, never a module: src-tauri/tauri.conf.json embeds the page's build, and the
      // edge orders that build before the shell's
      "ignoreDependencies": ["@repo/workspace"]
    },
    "apps/workspace": {
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile": {
      // expo reads fingerprint.config.js by its name when it fingerprints the native build
      "entry": ["fingerprint.config.js"],
      // linked natively; knip's expo plugin counts it only while `updates` is on, and app.config.js
      // leaves it off until the EAS project is committed. expo-linking, autolinked as
      // expo-share-intent's peer, needs no row: the expo plugin counts it, and a row draws a hint.
      // @repo/mobile-editor is the built editor page, never imported: plugins/with-editor-page.js
      // links its dist/ into the native build, and the edge orders its build before the app's
      "ignoreDependencies": ["expo-updates", "@repo/mobile-editor"]
    },
    "apps/extension": {
      // WXT's entrypoints live under its srcDir, src/, where knip's wxt plugin, which looks in
      // entrypoints/ at the workspace root, does not; a page's entry is its index.html's script
      "entry": ["src/entrypoints/*.ts", "src/entrypoints/*/main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // tailwindcss is @repo/ui's globals.css import, which knip does not follow
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile-editor": {
      "project": ["src/**/*.{ts,tsx,css}", "vite/**/*.ts"]
    },
    "apps/web": {
      // the type claims are vitest's `typecheck.include`, which knip's vitest plugin does not read;
      // scripts/ is `pnpm og:cards`'s and `pnpm agent-prompt`'s, run by node outside the build
      "entry": [
        "cloudflare.config.ts",
        "src/worker/index.ts",
        "src/worker/**/*.test-d.ts",
        "scripts/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.ts"],
      // stubs the Worker's program maps by `paths` (src/worker/tsconfig.json), which knip does not follow
      "ignore": ["src/worker/types/durable-git.d.ts", "src/worker/types/highlight-js.d.ts"],
      // `cloudflare:` is a workerd built-in module scheme, not a package; scripts/agent-prompt.ts reads
      // @repo/agent-skills' files through `import.meta.resolve`, which knip does not follow;
      // @repo/workspace is the library's page, never imported: vite.config.ts copies its build into
      // the Worker's assets, and the edge orders its build before the Worker's
      "ignoreDependencies": ["@repo/agent-skills", "@repo/workspace", "cloudflare", "tailwindcss"]
    },
    "packages/notes": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/editor": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/domain": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "tools/e2e": {
      // spawned by path from cloud-worker.ts
      "entry": ["src/harness/worker-host.ts"]
    },
    "tools/ui-gallery": {
      // the entry is index.html's script, which knip's vite plugin reads
      "project": ["src/**/*.{tsx,css}"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      // ApprovalCustomAnswer has no importer, not even a demo: it is an ALLOWED_EXPORTS row in the
      // orphan guard (tools/repo-guards/src/ui-orphan-exports.test.ts), which says why it stays
      "ignoreIssues": { "src/ai/approval-card.tsx": ["exports"] }
    }
  }
}
