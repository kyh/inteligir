{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // every unused export is reported, an entry's included: packages/* export every file as a
  // subpath, and an export no workspace imports is dead whatever the exports map says
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  // knip's plugins (vitest, vite, TanStack Router, expo-router, package.json scripts) find the
  // tests, routes and scripts, so an entry here is a file none of them can see. `pnpm knip` runs
  // twice, the second time `--production` (knip.dev/features/production-mode): what ships is a
  // pattern ending `!`, and a workspace's `test-support/`, which only suites import, is taken out
  // of it by `!…!`; a tool's workspace ships nothing, so it has no `!` pattern at all. An export
  // only a suite imports, a test-support one included, is tagged `@internal`, the tag knip reads
  // as "not reported in production mode" (knip.dev/reference/jsdoc-tsdoc-tags).
  "workspaces": {
    ".": {
      // the workflows' own scripts, which ship nothing
      "project": [".github/scripts/*.mjs"]
    },
    "apps/desktop": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"]
    },
    "apps/workspace": {
      "project": ["src/**/*.{ts,tsx,css}!", "!src/**/test-support/**!"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile": {
      // expo reads fingerprint.config.js by its name when it fingerprints the native build, and
      // its `module.exports` is what expo reads, which knip can neither see used nor be told of
      // (a JSDoc tag rides no CommonJS export); every other entry here is the expo-router plugin's
      "entry": ["fingerprint.config.js"],
      "includeEntryExports": false,
      "project": ["src/**/*.{ts,tsx,css}!", "plugins/*.js!", "!src/**/test-support/**!"],
      // linked natively; knip's expo plugin counts it only while `updates` is on, and app.config.js
      // leaves it off until the EAS project is committed. expo-linking, autolinked as
      // expo-share-intent's peer, needs no row: the expo plugin counts it, and a row draws a hint.
      // @repo/mobile-editor is the built editor page, never imported: plugins/with-editor-page.js
      // links its dist/ into the native build, and the edge orders its build before the app's
      "ignoreDependencies": ["expo-updates", "@repo/mobile-editor"]
    },
    "apps/extension": {
      // WXT's entrypoints live under its srcDir, src/, where knip's wxt plugin, which looks in
      // entrypoints/ at the workspace root, does not; a page's entry is its index.html's script
      "wxt": { "entry": ["src/entrypoints/*.ts", "src/entrypoints/*/main.tsx"] },
      "project": ["src/**/*.{ts,tsx,css}!", "*.ts", "!src/**/test-support/**!"],
      // tailwindcss is @repo/ui's globals.css import, which knip does not follow
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile-editor": {
      // vite/ is the build's own plugins
      "project": ["src/**/*.{ts,tsx,css}!", "vite/**/*.ts", "!src/**/test-support/**!"]
    },
    "apps/web": {
      // cloudflare.config.ts is what `cf build` deploys, its entrypoint src/worker/server.ts, which
      // mounts src/worker/index.ts, the suites' Worker; the type claims are vitest's
      // `typecheck.include`, which knip's vitest plugin does not read; scripts/ is `pnpm
      // og:cards`'s and `pnpm agent-prompt`'s, run by node outside the build
      "entry": [
        "cloudflare.config.ts!",
        "src/worker/index.ts!",
        "src/worker/**/*.test-d.ts",
        "scripts/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}!", "scripts/*.ts", "!src/**/test-support/**!"],
      // a stub the Worker's program maps by `paths` (src/worker/tsconfig.json), which knip does not follow
      "ignore": ["src/worker/types/highlight-js.d.ts"],
      // `cloudflare:` is a workerd built-in module scheme, not a package; scripts/agent-prompt.ts reads
      // @repo/agent-skills' files through `import.meta.resolve`, which knip does not follow;
      // @repo/workspace is the library's page, never imported: vite.config.ts copies its build into
      // the Worker's assets, and the edge orders its build before the Worker's
      "ignoreDependencies": ["@repo/agent-skills", "@repo/workspace", "cloudflare", "tailwindcss"]
    },
    "packages/agent-panel": { "project": ["src/**/*.ts!"] },
    "packages/contract": { "project": ["src/**/*.ts!", "!src/**/test-support/**!"] },
    "packages/domain": { "project": ["src/**/*.ts!"] },
    "packages/editor": { "project": ["src/**/*.{ts,tsx}!", "!src/**/test-support/**!"] },
    "packages/editor-bridge": { "project": ["src/**/*.ts!"] },
    "packages/library-replica": { "project": ["src/**/*.ts!", "!src/**/test-support/**!"] },
    "packages/notes": { "project": ["src/**/*.ts!", "!src/**/test-support/**!"] },
    "packages/page-reader": { "project": ["src/**/*.ts!", "!src/**/test-support/**!"] },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}!", "!src/**/test-support/**!"]
    },
    "tools/e2e": {
      // spawned by path from cloud-worker.ts
      "entry": ["src/harness/worker-host.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/messages-fake": {
      "project": ["src/**/*.ts"]
    },
    "tools/repo-guards": {
      "project": ["src/**/*.ts"]
    },
    "tools/ui-gallery": {
      // the entry is index.html's script, which knip's vite plugin reads
      "project": ["src/**/*.{tsx,css}"]
    }
  }
}
