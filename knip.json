{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".design-sync/**"],
  // The `packages/*` workspaces publish each source file as its own subpath
  // export (some through a `./*` wildcard), so knip reads EVERY file as an
  // entry — and knip's default is to trust an entry's exports as the public
  // API, which turns unused-export reporting off for the whole package. Each
  // workspace below states which side of that trade it is on, and why.
  "workspaces": {
    ".": {},
    // The e2e runner (src/run.ts) is already an entry via the package's own
    // `e2e` script; scenarios are reachable from it through static imports.
    "e2e": {
      "project": ["src/**/*.ts"]
    },
    "apps/app": {
      // The Start file routes are the UI roots; the router and the Node entry
      // are already known to knip (the vite plugin and the dev script). The
      // watcher child entry is forked, never imported, so knip cannot see its
      // caller.
      "entry": [
        "src/routes/**/*.tsx",
        "src/node/**/__tests__/**/*.test.ts",
        "src/app/**/__tests__/**/*.test.{ts,tsx}",
        "src/node/vault/watcher/parcel-child-entry.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/cli": {
      // The bin (bin/inteligir, a sh launcher knip cannot read) runs tsx over
      // src/index.ts in a checkout and the esbuild bundle when packaged —
      // hence the ignored tsx.
      "entry": ["src/index.ts", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"],
      "ignoreDependencies": ["tsx"]
    },
    // The Electron shell. `main` points at a build output, so the entries are
    // named here. The shipped main process still reaches `inteligir` as a
    // DIRECTORY rather than a module (src/main/server-paths.ts), and
    // electron-builder packs it from node_modules — but the packaged smoke now
    // imports that package's `staged-layout.mjs` instead of re-typing the
    // tree, which is what makes the dependency visible here.
    "apps/desktop": {
      "entry": ["scripts/*.{mjs,cjs}", "src/main/index.ts", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/*.{mjs,cjs}"]
    },
    // The published artifact. Its `bin` points at a build output, so the real
    // entries are named here. The two native modules are runtime deps of the
    // app bundle this package STAGES rather than imports — nothing under src/
    // may import either, so knip cannot see them. (@repo/app and @repo/cli are
    // deliberately not manifest dependencies at all: the relationship is a
    // build ORDER, declared in turbo.json.)
    "apps/launcher": {
      "entry": ["scripts/*.mjs", "src/main.ts", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["@parcel/watcher", "better-sqlite3"]
    },
    "apps/web": {
      // The Worker entry (src/worker/server.ts) is not listed: knip reads it
      // from wrangler.jsonc's `main`. `src/worker/index.ts` is the test suite's
      // entry (vitest.config `main`), which no plugin resolves.
      "entry": ["src/routes/**/*.tsx", "src/worker/index.ts", "src/worker/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // `cloudflare` is NOT a stale suppression, and NOT an npm package:
      // `cloudflare:workers` and `cloudflare:test` are workerd /
      // vitest-pool-workers BUILT-IN module specifiers. knip reads the
      // `cloudflare:` scheme prefix as a package name and reports them as
      // "unlisted dependencies". Removing it turns the gate red; installing a
      // `cloudflare` package would be worse.
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    // Carried ahead of its v3 consumers (issue #542): the package's public
    // surface is deliberately wider than today's importers, so its entry
    // exports are trusted as API rather than reported. Flip this back to
    // `includeEntryExports: true` once the v3 features consume it in-repo.
    "packages/notes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // Same trade as packages/notes: built ahead of its v3 consumers (issue
    // #550), so entry exports are trusted as API. Every vendored ProseMark
    // module is an entry for the same reason packages/ui trusts its vendored
    // components: those exports are the UPSTREAM surface, and trimming them
    // makes the next re-vendor a conflict. dev/ is the human-eyes vite demo.
    "packages/editor": {
      "entry": [
        "src/**/__tests__/**/*.test.ts",
        "src/vendor/prosemark/lib/**/*.ts",
        "src/vendor/prosemark/tests/*.test.ts",
        "dev/main.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "dev/**/*.ts"]
    },
    "packages/typed-routes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // Vendored-from-bb thread domain + projection (issue #548): the public
    // surface is the vendored bb API, wider than today's importers on
    // purpose — trimming it makes the next re-vendor a conflict.
    "packages/domain": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // Vendored-from-bb runtime + codex adapter (issue #549). Entries are the
    // package exports (knip reads them itself), the tests, and the fake
    // app-server script (spawned, never imported — knip cannot see its
    // caller). The generated codex schema keeps upstream's PascalCase file
    // names.
    //
    // Unused-export reporting is ON for every file that is NOT itself a
    // package export — which is where it earns its keep, and also the limit
    // worth stating: the nine `exports` targets are entries, and knip trusts
    // an entry's exports as API. So the vendored surface those nine declare
    // (upstream's schema/values/type triples, the adapter contract) is not
    // reported, deliberately — trimming it is what makes the next re-vendor a
    // conflict. Trim residue in the OTHER thirty-odd modules still surfaces.
    "packages/agent-runtime": {
      "entry": ["src/**/__tests__/**/*.test.ts", "src/test-support/fake-codex-app-server.mjs"],
      "project": ["src/**/*.{ts,mjs}"]
    },
    "packages/thread-view": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server-contract": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // Same trade as packages/domain: the cloud contract is built ahead of its
    // app-side consumer (issue #554's follow-up sync client), so its entry
    // exports are trusted as API rather than reported.
    "packages/cloud-contract": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // Derived fitness tests over the repo itself. Every file is a suite or the
    // tree walk they share, so the suites ARE the entries.
    "tools/repo-guards": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // The ONE package that keeps knip's default `includeEntryExports: false`,
    // and the reason is the package rather than the findings. `src/components`
    // is VENDORED shadcn: each file is copied from the registry, recorded in
    // components.provenance.json, and re-pullable with one command — so its
    // exports are the UPSTREAM component's surface, not this repo's. Deleting
    // `DialogClose` because nothing calls it today makes the next re-pull a
    // conflict and the provenance record a lie.
    //
    // The invariant that actually has teeth here is coarser and lives as a
    // test: src/__tests__/no-orphan-components.test.ts fails when a whole
    // component file has no consumer (a real failure knip cannot see either,
    // since the `./components/*` wildcard export makes every file an entry).
    // Turning this on would only ever report members of files that guard
    // already proves are in use.
    "packages/ui": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": false
    }
  }
}
