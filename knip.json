{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gh", "tar", "ps", "tasklist"],
  "workspaces": {
    ".": {},
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.html",
        "src/renderer/main.tsx",
        "src/__tests__/**/*.test.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["scripts/**/*.mjs", "src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@tailwindcss/vite", "@vitejs/plugin-react", "electron-builder"]
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}", "src/components/**/*.{ts,tsx}"],
      "project": ["*.config.{js,mjs}", "src/**/*.{ts,tsx}"]
    },
    "packages/agent-runtime": {
      "includeEntryExports": true
    },
    "packages/pi-driver": {
      "includeEntryExports": true
    },
    "packages/ui": {
      // A consumed component library: its exports are the public API, and the
      // vendored @fluid components intentionally export surface (variants,
      // sub-components, foundations) the app may not use internally yet. Treat
      // entry exports as the API rather than flag them as dead.
      "includeEntryExports": false
    }
  }
}
