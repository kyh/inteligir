{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".design-sync/**"],
  // The `packages/*` workspaces publish each source file as its own subpath
  // export (some through a `./*` wildcard), so knip reads EVERY file as an
  // entry — and knip's default is to trust an entry's exports as the public
  // API, which turns unused-export reporting off for the whole package. Each
  // workspace below states which side of that trade it is on, and why.
  "workspaces": {
    ".": {},
    // The published artifact: the CLI and the server it runs. The bin
    // (bin/inteligir, a sh launcher knip cannot read) runs tsx over
    // src/index.ts in a checkout and the esbuild bundle when packaged — hence
    // the ignored tsx. The watcher child is forked and the transcription
    // worker is started as a thread; both are resolved by PATH at runtime and
    // bundled as their own esbuild entries, so knip cannot see either caller.
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.test.ts",
        "src/server/vault/watcher/parcel-child-entry.ts",
        "src/server/voice/transcribe-worker.ts",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"],
      // The ACP adapters are ARTIFACTS, and they are declared by this package
      // because this is the one that ships: harness-registry resolves their
      // entry files with `require`, which walks up from the RUNNING bundle, so
      // an adapter declared only by @repo/agent-runtime becomes unreachable the
      // moment that package is inlined.
      "ignoreDependencies": ["@zed-industries/claude-code-acp", "@zed-industries/codex-acp", "tsx"]
    },
    // THE SHIPPED PRODUCT: the window, and the page inside it. `main` points at
    // a build output, so electron-vite's own config is what names the three
    // bundles; what is added here is the renderer's file routes, which are the
    // UI roots.
    "apps/desktop": {
      "entry": [
        "scripts/*.{mjs,cjs}",
        "src/renderer/routes/**/*.tsx",
        "src/**/__tests__/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.{mjs,cjs}"],
      // The route tree is GENERATED by @tanstack/router-plugin and committed;
      // the three lookup interfaces it exports are part of the shape it writes,
      // not something this app chose to publish.
      "ignore": ["src/renderer/routeTree.gen.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    // The mobile companion (issue #576). The expo-router file routes under
    // src/app are the UI roots; the tests are the sync/credential/pairing
    // suites. app.config.js declares `updates: { enabled: false }`, which is
    // what stops knip's Expo plugin synthesizing an `expo-updates` dependency
    // nothing installs — keep it there rather than adding an ignore here. The
    // native/peer deps (`@expo/metro-runtime`, `react-native-screens`,
    // `expo-system-ui`) are resolved by knip's Expo plugin from app.config, so
    // they need no explicit ignore.
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,js}"]
    },
    "apps/web": {
      // The Worker entry (src/worker/server.ts) is not listed: knip reads it
      // from wrangler.jsonc's `main`. `src/worker/index.ts` is the test suite's
      // entry (vitest.config `main`), which no plugin resolves.
      "entry": ["src/routes/**/*.tsx", "src/worker/index.ts", "src/worker/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // Hand-authored .d.ts for durable-git (the package ships TS source, no
      // types). A stub declares the MODULE's surface, not this repo's usage —
      // unused-export reporting over it would demand trimming the module's own
      // API, which is exactly what makes the next version bump a conflict.
      "ignore": ["src/worker/types/durable-git.d.ts"],
      // `cloudflare` is NOT a stale suppression, and NOT an npm package:
      // `cloudflare:workers` and `cloudflare:test` are workerd /
      // vitest-pool-workers BUILT-IN module specifiers. knip reads the
      // `cloudflare:` scheme prefix as a package name and reports them as
      // "unlisted dependencies". Removing it turns the gate red; installing a
      // `cloudflare` package would be worse.
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    // Unused-export reporting is ON here, which is what makes a subsystem with
    // no consumer show up rather than hide behind the exports map (every
    // subpath in it is an entry, and an entry's exports are trusted by
    // default). Two things narrow that, and both are rules rather than a
    // blanket:
    //
    // `ignoreExportsUsedInFile` — a module that exports a type it also uses
    // itself is naming a part of its own shape, and a consumer needs the name
    // to hold the value (GraphNode/GraphEdge inside LinkGraph, WikiBody inside
    // WikiBodyRange, the schema version the store compares against). WikiLink
    // and WikiEmbed additionally reach consumers through a `declare module
    // "mdast"` augmentation, which knip cannot follow at all.
    //
    // Everything left is a per-export `@public` tag carrying its own reason.
    // Today that is exactly zero — every export earned a consumer — and any
    // `@public` appearing needs its own stated reason, which is the point.
    "packages/notes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    // Same trade as packages/notes: every subpath is an entry the app and the
    // headless mirror import piecemeal. The Plate kit/registry adaptations
    // keep their upstream-shaped exports for the same
    // reason packages/ui trusts its vendored components: trimming them makes
    // the next re-vendor a conflict.
    "packages/editor": {
      "entry": ["src/**/__tests__/**/*.test.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    // Vendored-from-bb thread domain + projection (issue #548): the public
    // surface is the vendored bb API, wider than today's importers on
    // purpose — trimming it makes the next re-vendor a conflict.
    "packages/domain": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // Vendored-from-bb runtime + codex adapter (issue #549). Entries are the
    // package exports (knip reads them itself), the tests, and the fake
    // app-server script (spawned, never imported — knip cannot see its
    // caller). The generated codex schema keeps upstream's PascalCase file
    // names.
    //
    // Unused-export reporting is ON for every file that is NOT itself a
    // package export — which is where it earns its keep, and also the limit
    // worth stating: the nine `exports` targets are entries, and knip trusts
    // an entry's exports as API. So the vendored surface those nine declare
    // (upstream's schema/values/type triples, the adapter contract) is not
    // reported, deliberately — trimming it is what makes the next re-vendor a
    // conflict. Trim residue in the OTHER thirty-odd modules still surfaces.
    "packages/agent-runtime": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,mjs}"],
      // The ACP adapters are ARTIFACTS: harness-registry createRequire-resolves
      // their entry files to spawn as children; no module import exists.
      "ignoreDependencies": ["@zed-industries/claude-code-acp", "@zed-industries/codex-acp"]
    },
    "packages/thread-view": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // ONE contract package, TWO entry points — every subpath in its exports
    // map is an entry, so its exports are trusted as API rather than reported.
    // That is the right trade here: the contract is the surface, and a
    // procedure with no caller yet is a promise, not dead weight.
    "packages/api": {
      "entry": ["src/**/__tests__/**/*.test.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // The e2e runner (src/run.ts) is already an entry via the package's own
    // `e2e` script; scenarios are reachable from it through static imports.
    "tools/e2e": {
      "project": ["src/**/*.ts"]
    },
    // Derived fitness tests over the repo itself. Every file is a suite or the
    // tree walk they share, so the suites ARE the entries.
    "tools/repo-guards": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    // The ONE package that keeps knip's default `includeEntryExports: false`,
    // and the reason is the package rather than the findings. `src/components`
    // is VENDORED shadcn: each file is copied from the registry and
    // re-pullable with the shadcn CLI — so its
    // exports are the UPSTREAM component's surface, not this repo's. Deleting
    // `DialogClose` because nothing calls it today makes the next re-pull a
    // conflict.
    //
    // The invariant that actually has teeth here is coarser and lives as a
    // test: src/__tests__/no-orphan-components.test.ts fails when a whole
    // component file has no consumer (a real failure knip cannot see either,
    // since the `./components/*` wildcard export makes every file an entry).
    // Turning this on would only ever report members of files that guard
    // already proves are in use.
    "packages/ui": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": false
    }
  }
}
