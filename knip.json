{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".design-sync/**"],
  "workspaces": {
    ".": {},
    "apps/desktop": {
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx", "src/lib/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,js}"]
      // No `ignoreDependencies` here on purpose. knip's Expo plugin SYNTHESIZES
      // an `expo-updates` dependency for any app config that doesn't say
      // `updates: { enabled: false }` (knip/dist/plugins/expo/helpers.js), and
      // apps/mobile neither declares nor references that package — without the
      // opt-out, knip demands an ignore for a package nothing installs.
      // app.config.js declares that opt-out, which is true (no OTA updates, not
      // registered with EAS) and makes the suppression unnecessary. If knip
      // reports expo-updates, the opt-out is missing from app.config.js — put
      // it back there rather than adding an ignore here.
    },
    "apps/web": {
      // The Worker entry (src/worker/server.ts) is not listed: knip reads it
      // from wrangler.jsonc's `main`. `src/worker/index.ts` is the test suite's
      // entry (vitest.config `main`), which no plugin resolves.
      "entry": ["src/routes/**/*.tsx", "src/worker/index.ts", "src/worker/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // `cloudflare` is NOT a stale suppression, and NOT an npm package:
      // `cloudflare:workers` and `cloudflare:test` are workerd /
      // vitest-pool-workers BUILT-IN module specifiers. knip reads the
      // `cloudflare:` scheme prefix as a package name and reports them as
      // "unlisted dependencies". Removing it turns the gate red; installing a
      // `cloudflare` package would be worse.
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    // The agent container image is its own npm project, built from this repo by
    // the Dockerfile. The daemon entry is resolved from the package's `bin`
    // field; `src/protocol.ts` is the pure wire contract @repo/web imports.
    "apps/web/container": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/bridge": {
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/editor": {
      "entry": ["src/__tests__/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": false
    },
    "packages/notes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/ui": {
      "entry": [],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": false
    },
    "packages/workspace": {
      "entry": ["src/__tests__/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": false
    },
    "tools/repo-guards": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
