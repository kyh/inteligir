{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gh"],
  "workspaces": {
    ".": {
      "entry": ["vitest.workspace.ts"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.html",
        "src/renderer/main.tsx",
        "src/__tests__/**/*.test.ts",
        "scripts/**/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs",
        "src/**/*.{ts,tsx,css}"
      ],
      "ignoreDependencies": [
        "@tailwindcss/vite",
        "@vitejs/plugin-react",
        "electron-builder"
      ]
    },
    "apps/web": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}"
      ],
      "project": ["*.config.{js,mjs}", "src/**/*.{ts,tsx}"]
    }
  }
}
