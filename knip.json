{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".design-sync/**"],
  // packages/* export every file as a subpath, so knip reads each as an entry and trusts its
  // exports; includeEntryExports turns reporting back on where the exports are not the API
  "workspaces": {
    ".": {},
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.test.ts",
        "src/server/vault/watcher/parcel-child-entry.ts",
        "src/server/voice/transcribe-worker.ts",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"],
      // the ACP adapters are resolved with require from the running bundle, never imported
      "ignoreDependencies": ["@zed-industries/claude-code-acp", "@zed-industries/codex-acp", "tsx"]
    },
    "apps/desktop": {
      "entry": [
        "scripts/*.{mjs,cjs}",
        "src/renderer/routes/**/*.tsx",
        "src/**/__tests__/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.{mjs,cjs}"],
      "ignore": ["src/renderer/routeTree.gen.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx", "src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,js}"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "src/worker/index.ts", "src/worker/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignore": ["src/worker/types/durable-git.d.ts"],
      // `cloudflare:` is a workerd built-in module scheme, not a package
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    "packages/notes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/editor": {
      "entry": ["src/**/__tests__/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/domain": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/agent-runtime": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,mjs}"],
      "ignoreDependencies": ["@zed-industries/claude-code-acp", "@zed-industries/codex-acp"]
    },
    "packages/api": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "tools/e2e": {
      "project": ["src/**/*.ts"]
    },
    "tools/repo-guards": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    }
  }
}
