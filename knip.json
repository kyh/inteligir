{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gh", "tar", "ps", "tasklist", "xcrun", "spctl"],
  "workspaces": {
    ".": {},
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.html",
        "src/renderer/main.tsx",
        "src/__tests__/**/*.test.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["scripts/**/*.mjs", "src/**/*.{ts,tsx,css}"],
      // sherpa-onnx-node: not imported by desktop source (host imports it),
      // but it must stay a desktop dependency so electron-builder packs the
      // externalized native module (+ its sherpa-onnx-* platform binaries)
      // into the app bundle.
      "ignoreDependencies": [
        "@tailwindcss/vite",
        "@vitejs/plugin-react",
        "electron-builder",
        "sherpa-onnx-node"
      ]
    },
    "apps/web": {
      "entry": ["src/router.tsx", "src/routes/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      // tailwindcss is referenced only from globals.css (@import), which knip
      // doesn't parse.
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/agent-runtime": {
      "includeEntryExports": true
    },
    "packages/app": {
      // The portable UI, source-imported by the desktop renderer. The dev
      // harness (dev/main.tsx) is picked up via its vite config.
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css,js}", "dev/**/*.{ts,tsx}"],
      "includeEntryExports": false
    },
    "packages/host": {
      // The node backend, source-imported by its shells (desktop today,
      // server later) through its `./*` exports — don't flag them as unused.
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/features": {
      // Isomorphic contract + pure-logic library consumed by every host
      // (desktop shell, web server, browser client). Its `./*` exports are
      // the public API across hosts, so don't flag them as unused.
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/pi-driver": {
      "includeEntryExports": true
    },
    "packages/ui": {
      // A consumed component library: its exports are the public API, and the
      // vendored @fluid components intentionally export surface (variants,
      // sub-components, foundations) the app may not use internally yet. Treat
      // entry exports as the API rather than flag them as dead.
      "includeEntryExports": false
    }
  }
}
