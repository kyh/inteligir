{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gh", "tar", "ps", "tasklist"],
  "workspaces": {
    ".": {},
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.html",
        "src/renderer/main.tsx",
        "src/__tests__/**/*.test.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["scripts/**/*.mjs", "src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@tailwindcss/vite", "@vitejs/plugin-react", "electron-builder"]
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}", "src/components/**/*.{ts,tsx}"],
      "project": ["*.config.{js,mjs}", "src/**/*.{ts,tsx}"]
    },
    "packages/agent-runtime": {
      "includeEntryExports": true
    },
    "packages/pi-driver": {
      "includeEntryExports": true
    },
    "packages/ui": {
      // Library mode during the notes-app rebuild: @repo/ui is a shared
      // component kit whose public API (the wildcard ./components/* exports) is
      // validated by app usage, not by internal knip. The surface is actively
      // growing back across milestones, so per-component dead-export churn isn't
      // worth it. M6 prunes the kit to its final set and re-enables
      // includeEntryExports.
      "includeEntryExports": false
    }
  }
}
