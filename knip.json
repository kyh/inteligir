{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // knip's plugins (vitest, vite, TanStack Router, expo-router, package.json scripts) find the
  // tests, routes and scripts, so an entry here is a file none of them can see. A `project` glob
  // stays only where it names CSS, which knip's default project leaves out.
  // packages/* export every file as a subpath, so knip reads each as an entry and trusts its
  // exports; includeEntryExports turns reporting back on where the exports are not the API
  "workspaces": {
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/desktop/desktop-entry.ts",
        "src/server/vault/watcher/parcel-child-entry.ts",
        "src/server/knowledge/projection-worker.ts",
        "src/server/items/capture/item-fill-worker.ts"
      ],
      // the vault service's suite makes a named pipe with the system's own mkfifo, which no
      // package provides
      "ignoreBinaries": ["mkfifo"],
      // the ACP adapters are resolved with require from the running bundle, never imported
      "ignoreDependencies": [
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp"
      ]
    },
    "apps/desktop": {
      "entry": ["scripts/*.ts"],
      // a build output and a dev server, never a module: src-tauri/tauri.conf.json embeds its
      // first-run page and runs its Vite under `tauri dev`
      "ignoreDependencies": ["@repo/workspace"]
    },
    "apps/workspace": {
      // the first-run page is a build of its own (vite.config.ts), and first-run.html's script is
      // read by knip's vite plugin only from index.html
      "entry": ["src/first-run/first-run-main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile": {
      // expo reads fingerprint.config.js by its name when it fingerprints the native build
      "entry": ["fingerprint.config.js"],
      // linked natively; knip's expo plugin counts it only while `updates` is on, and app.config.js
      // leaves it off until the EAS project is committed. expo-linking, autolinked as
      // expo-share-intent's peer, needs no row: the expo plugin counts it, and a row draws a hint.
      "ignoreDependencies": ["expo-updates"]
    },
    "apps/extension": {
      // WXT's entrypoints live under its srcDir, src/, where knip's wxt plugin, which looks in
      // entrypoints/ at the workspace root, does not; a page's entry is its index.html's script
      "entry": ["src/entrypoints/*.ts", "src/entrypoints/*/main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // tailwindcss is @repo/ui's globals.css import, which knip does not follow
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/mobile-editor": {
      "project": ["src/**/*.{ts,tsx,css}", "vite/**/*.ts"]
    },
    "apps/web": {
      "entry": ["cloudflare.config.ts", "src/worker/index.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignore": ["src/worker/types/durable-git.d.ts"],
      // `cloudflare:` is a workerd built-in module scheme, not a package
      "ignoreDependencies": ["cloudflare", "tailwindcss"]
    },
    "packages/notes": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/editor": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/domain": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/agent-runtime": {
      // the fake vendors are spawned by path, never imported
      "entry": ["src/test-support/*.mjs"]
    },
    "tools/e2e": {
      // spawned by path: the Worker host from cloud-worker.ts, the fake vendor from its scenario
      "entry": ["src/harness/worker-host.ts", "src/fixtures/*.mjs"]
    },
    "tools/ui-gallery": {
      // the entry is index.html's script, which knip's vite plugin reads
      "project": ["src/**/*.{tsx,css}"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      // ApprovalCustomAnswer has no importer, not even a demo: it is an ALLOWED_EXPORTS row in the
      // orphan guard (tools/repo-guards/src/ui-orphan-exports.test.ts), which says why it stays
      "ignoreIssues": { "src/ai/approval-card.tsx": ["exports"] }
    }
  }
}
