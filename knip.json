{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gh", "ps", "tasklist", "xcrun", "spctl"],
  "ignore": [".design-sync/**"],
  "workspaces": {
    ".": {},
    "apps/cloud": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.html",
        "src/renderer/main.tsx",
        "src/__tests__/**/*.test.ts",
        "src/renderer/__tests__/**/*.test.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["scripts/**/*.mjs", "src/**/*.{ts,tsx,css}", "dev/**/*.{ts,tsx}"],
      "ignoreDependencies": ["electron-builder", "sherpa-onnx-node"]
    },
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx", "src/lib/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,js}"],
      "ignoreDependencies": ["metro-cache", "expo-updates"]
    },
    "apps/web": {
      "entry": ["src/router.tsx", "src/routes/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/agent": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/bridge": {
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/connectors": {
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/installer": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/notes": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/server": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/storage": {
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/sync": {
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/ui": {
      "includeEntryExports": false
    },
    "packages/vault": {
      "entry": ["src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "packages/voice": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    }
  }
}
