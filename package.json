{
  "name": "inteligir",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "cli": "apps/cli/bin/inteligir",
    "dev": "turbo watch dev -F @repo/app...",
    "dev:desktop": "turbo run build --filter=@repo/desktop && pnpm --filter @repo/desktop dev",
    "dev:web": "turbo watch dev -F @repo/web...",
    "e2e": "pnpm --filter @repo/e2e e2e",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "package:desktop": "turbo run build --filter=@repo/desktop && pnpm --filter @repo/desktop package",
    "package:launcher": "turbo run build --filter=inteligir",
    "prepare": "git config core.hooksPath .githooks || true",
    "smoke:desktop": "pnpm package:desktop && pnpm --filter @repo/desktop smoke",
    "smoke:launcher": "turbo run build --filter=inteligir && pnpm --filter inteligir smoke",
    "test": "turbo run test --concurrency=4",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm format && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@kyh/oxlint": "^0.1.2",
    "dotenv-cli": "^11.0.0",
    "knip": "^6.32.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.11",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@types/react": "catalog:"
    }
  }
}
