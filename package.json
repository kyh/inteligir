    "eslint-plugin-tailwindcss": "^3.13.0",
    "pino-pretty": "^10.2.0",
    "postcss": "^8.4.27",
    "prettier": "^3.0.1",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "rehype": "^12.0.1",
    "rehype-autolink-headings": "^6.1.1",
