{
  "name": "inteligir-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf .cache .turbo node_modules apps/*/.cache apps/*/.expo apps/*/.output apps/*/.tanstack apps/*/.turbo apps/*/.wrangler apps/*/android apps/*/dist apps/*/ios apps/*/node_modules packages/*/.cache packages/*/.turbo packages/*/dist packages/*/node_modules tools/*/.cache tools/*/.turbo tools/*/node_modules",
    "cli": "apps/cli/bin/inteligir",
    "dev": "turbo run dev -F @repo/desktop",
    "dev:desktop": "turbo run dev -F @repo/desktop",
    "dev:mobile": "turbo run dev -F @repo/mobile",
    "dev:web": "turbo watch dev -F @repo/web...",
    "e2e": "pnpm --filter @repo/e2e e2e",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "knip": "knip",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "package:cli": "turbo run build --filter=inteligir",
    "package:desktop": "turbo run package --filter=@repo/desktop",
    "prepare": "git config core.hooksPath .githooks || true",
    "smoke:cli": "turbo run build --filter=inteligir && pnpm --filter inteligir smoke",
    "smoke:desktop": "pnpm package:desktop && pnpm --filter @repo/desktop smoke",
    "test": "turbo run test --concurrency=4",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm format && pnpm test && pnpm build"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "^7.11.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
