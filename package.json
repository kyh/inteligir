    "lucide-react": "^0.265.0",
    "next": "13.4.12",
    "next-contentlayer": "^0.3.4",
    "nodemailer": "^6.9.4",
    "pino": "^8.15.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.45.4",
    "react-top-loading-bar": "^2.3.1",
    "recharts": "^2.7.3",
    "server-only": "^0.0.1",
    "shiki": "^0.14.3",
    "sonner": "^0.6.2",
    "stripe": "^12.17.0",
    "swr": "^2.2.0",
    "tailwind-merge": "^1.14.0",
