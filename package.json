{
  "name": "inteligir-monorepo",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.ts",
    "build": "turbo run build",
    "clean": "git clean -xdf .cache .turbo node_modules apps/*/.cache apps/*/.expo apps/*/.next apps/*/.output apps/*/.turbo apps/*/.wxt apps/*/dist apps/*/ios apps/*/.simulator apps/*/node_modules packages/*/.cache packages/*/.turbo packages/*/dist packages/*/node_modules tools/*/.cache tools/*/.turbo tools/*/node_modules",
    "cli": "pnpm --silent --filter @repo/cli build >/dev/null && node apps/cli/dist/inteligir.js",
    "db:push": "pnpm --filter @repo/db push",
    "db:push-remote": "pnpm --filter @repo/db push:remote",
    "db:seed": "pnpm --filter @repo/service seed",
    "db:start": "pnpm --filter @repo/db start",
    "dev": "turbo run dev -F @repo/desktop",
    "dev:extension": "turbo watch dev -F @repo/extension...",
    "dev:mobile": "turbo run dev -F @repo/mobile",
    "dev:web": "turbo watch dev -F @repo/web...",
    "e2e": "turbo run e2e",
    "e2e:firefox": "turbo run e2e:firefox",
    "e2e:mobile": "EXPO_PUBLIC_CLOUD_URL=http://localhost:5175 turbo run e2e:mobile",
    "e2e:webkit": "turbo run e2e:webkit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write && turbo run format:fix",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "package:desktop": "turbo run package --filter=@repo/desktop",
    "package:extension": "turbo run zip --filter=@repo/extension",
    "prepare": "git config core.hooksPath .githooks || true",
    "smoke": "tsx scripts/smoke.ts",
    "test": "turbo run test --concurrency=${TEST_CONCURRENCY:-4}",
    "testflight:mobile": "pnpm --filter @repo/mobile testflight",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "verify": "tsc --noEmit && (turbo run lint; lint=$?; turbo run typecheck knip format test build --continue=dependencies-successful --concurrency=${TEST_CONCURRENCY:-4} && exit $lint)",
    "verify:affected": "tsc --noEmit && (turbo run lint --affected; lint=$?; turbo run typecheck knip test build --affected --continue=dependencies-successful --concurrency=${TEST_CONCURRENCY:-4} && exit $lint)"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.1.0",
    "@kyh/tsconfig": "catalog:",
    "@orpc/client": "catalog:",
    "@repo/contract": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "knip": "^6.47.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "^8.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.23.0"
}
