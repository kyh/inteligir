{
  "name": "inteligir",
  "version": "0.2.3",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "contentlayer build && next build",
    "dev": "concurrently \"contentlayer dev\" \"next dev\"",
    "dev:test": "NODE_ENV=test next dev",
    "format": "prettier --write src",
    "lint": "next lint",
    "start": "next start",
    "stripe:listen": "docker run --rm -it --name=stripe -v ~/.config/stripe:/root/.config/stripe stripe/stripe-cli:latest listen --forward-to http://host.docker.internal:3000/api/stripe/webhook",
    "stripe:mock-server": "docker run --rm -it -p 12111-12112:12111-12112 stripe/stripe-mock:latest",
    "supabase:db-reset": "supabase db reset",
    "supabase:start": "supabase start --ignore-health-check",
    "supabase:stop": "supabase stop",
    "supabase:gen-types": "supabase gen types typescript --local > src/core/database.types.ts",
    "test:db": "supabase test db --debug",
    "test:e2e": "sh ./scripts/test.sh",
    "test:reset:db": "supabase db reset && supabase test db --debug"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.15",
    "@heroicons/react": "^2.0.18",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-popover": "^1.0.6",
    "@radix-ui/react-select": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.0.6",
    "@react-email/body": "^0.0.2",
    "@react-email/button": "^0.0.9",
    "@react-email/column": "^0.0.7",
    "@react-email/head": "^0.0.5",
    "@react-email/html": "^0.0.4",
    "@react-email/preview": "^0.0.6",
    "@react-email/render": "^0.0.7",
    "@react-email/section": "^0.0.9",
    "@react-email/text": "^0.0.5",
    "@sentry/node": "^7.56.0",
    "@sentry/react": "^7.56.0",
    "@sentry/tracing": "^7.56.0",
    "@supabase/auth-helpers-nextjs": "^0.7.2",
    "@supabase/supabase-js": "^2.26.0",
    "@tw-classed/react": "^1.5.1",
    "@vercel/analytics": "^1.0.1",
    "@vercel/og": "^0.5.8",
    "clsx": "^1.2.1",
    "cmdk": "^0.2.0",
    "contentlayer": "^0.3.3",
    "csrf": "^3.1.0",
    "date-fns": "^2.30.0",
    "edge-csrf": "^1.0.4",
    "framer-motion": "^10.12.17",
    "heroicons": "^2.0.18",
    "lucide-react": "^0.255.0",
    "next": "^13.4.7",
    "next-contentlayer": "^0.3.3",
    "nodemailer": "^6.9.3",
    "pino": "^8.14.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.45.0",
    "react-hot-toast": "^2.4.1",
    "react-top-loading-bar": "^2.3.1",
    "recharts": "^2.7.2",
    "server-only": "^0.0.1",
    "shiki": "^0.14.3",
    "stripe": "^12.10.0",
    "swr": "^2.2.0",
    "tailwind-merge": "^1.13.2",
    "tiny-invariant": "^1.3.1",
    "zod": "^3.21.4",
    "zustand": "^4.3.8"
