{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "prompt": "inteligir is driven by coding agents — read AGENTS.md first. The repo is mid-rewrite: v3 architecture is GitHub issue #542. What runs today is the marketing + auth Worker (apps/web); `pnpm dev:web` serves it locally on :5174 (pinned). Gate with `pnpm format:fix && pnpm verify` — format:fix runs BEFORE the gates, never after. Never run `db:push` or `db:studio`: both target the PRODUCTION D1. The local one is `db:push:local`.",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm knip:*)",
      "Bash(pnpm dev:web)",
      "Bash(pnpm --filter @repo/web dev)",
      "Bash(pnpm --filter @repo/web test)",
      "Bash(pnpm --filter @repo/web db:push:local)",
      "Bash(agent-browser:*)"
    ],
    "deny": [
      "Bash(pnpm --filter @repo/web db:push)",
      "Bash(pnpm -F @repo/web db:push)",
      "Bash(pnpm --filter @repo/web db:studio)",
      "Bash(pnpm -F @repo/web db:studio)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && cd \"$CLAUDE_PROJECT_DIR\" && pnpm install || true",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
