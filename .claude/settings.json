{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm knip:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm bootstrap:*)",
      "Bash(pnpm turbo run:*)",
      "Bash(pnpm exec oxlint:*)",
      "Bash(pnpm exec oxfmt:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm --filter @repo/db push)",
      "Bash(pnpm --filter @repo/db ddl:*)",
      "Bash(pnpm --filter @repo/db bootstrap:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(agent-browser:*)"
    ],
    "deny": [
      "Bash(pnpm --filter @repo/db push:remote:*)",
      "Bash(pnpm -F @repo/db push:remote:*)",
      "Bash(pnpm --filter @repo/db studio:remote:*)",
      "Bash(pnpm -F @repo/db studio:remote:*)",
      "Bash(pnpm push:remote:*)",
      "Bash(pnpm run push:remote:*)",
      "Bash(pnpm studio:remote:*)",
      "Bash(pnpm run studio:remote:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && cd \"$CLAUDE_PROJECT_DIR\" && pnpm install || true",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && pnpm exec ultracite fix --hook"
          }
        ]
      }
    ]
  }
}
