{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc/json-schema-for-oxfmt/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "dist-electron",
    "dist-web",
    "node_modules",
    "pnpm-lock.yaml",
    "*.tsbuildinfo",
    ".expo",
    ".wxt",
    ".output",
    ".tanstack",
    "out",
    "routeTree.gen.ts"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "react", "oxc", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // No `as` casts (`as const` stays allowed). The few legitimate
    // third-party/type-system bridges carry a one-line justification plus an
    // inline disable; everything else gets a real type, guard, or generic.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "react/react-in-jsx-scope": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    // expo-status-bar's StatusBar takes `style` as a string variant, not CSS.
    "react/style-prop-object": ["error", { "allow": ["StatusBar"] }],
    // Render props (React Navigation headerRight, FlatList renderItem) are legit.
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }]
  },
  "overrides": [
    {
      // Tests may cast at mock seams (partial doubles of wide interfaces).
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      // Dependency boundary: the host library is platform-agnostic. Electron
      // (and the desktop shell) reach it only through the injected
      // HostPlatform (packages/host/src/platform.ts).
      "files": ["packages/host/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/*",
                  "electron-updater",
                  "@repo/desktop",
                  "@repo/desktop/*",
                  "**/apps/desktop/**"
                ],
                "message": "packages/host is platform-agnostic — no electron/desktop imports; inject via HostPlatform (src/platform.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      // Dependency boundary: agent/ must stay host-free (the old "agent never
      // imports main" rule, re-rooted). Any relative import that climbs out
      // of src/agent/ reaches host internals; capabilities are injected as
      // AgentPorts from lib/agent-lifecycle.ts. Two blocks because the rule
      // is per-specifier text: one "../" escapes from agent/*.ts, two from
      // agent/<bundle>/*.ts.
      "files": ["packages/host/src/agent/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron", "electron/*", "../**"],
                "message": "agent/ must not reach into the host — inject via AgentPorts (lib/agent-lifecycle.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host/src/agent/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron", "electron/*", "../../**"],
                "message": "agent/ must not reach into the host — inject via AgentPorts (lib/agent-lifecycle.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      // Dependency boundary: the server app is a headless node shell over
      // @repo/host — never electron or the desktop shell.
      "files": ["apps/server/src/**", "apps/server/bin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/*",
                  "electron-updater",
                  "@repo/desktop",
                  "@repo/desktop/*",
                  "**/apps/desktop/**"
                ],
                "message": "the server app is headless node — no electron/desktop imports"
              }
            ]
          }
        ]
      }
    },
    {
      // Dependency boundary: features is isomorphic — the same modules load in
      // the browser (bridge-ws-client), the Electron renderer, and node
      // hosts. No node built-ins, no electron.
      "files": ["packages/features/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron", "electron/*", "node:*", "@repo/desktop", "@repo/desktop/*"],
                "message": "packages/features is isomorphic — no node/electron imports"
              }
            ]
          }
        ]
      }
    },
    {
      // Dependency boundary: the renderer UI is host-agnostic. It reaches the
      // backend only through the injected Bridge (renderer/lib/bridge.ts) —
      // never electron, node built-ins, the node host, or the main process.
      "files": ["apps/desktop/src/renderer/**", "apps/desktop/dev/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/*",
                  "electron-updater",
                  "node:*",
                  "@repo/host",
                  "@repo/host/*",
                  "@/main/*",
                  "@/preload/*"
                ],
                "message": "the renderer UI is host-agnostic — no electron/node/host/main imports; reach the backend through the injected Bridge (@renderer/lib/bridge)"
              }
            ]
          }
        ]
      }
    },
    {
      // Tests run under vitest on node and read fixture files from disk. The
      // portability boundary above applies to shipped renderer code, not the
      // test harness.
      "files": ["apps/desktop/src/renderer/__tests__/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
