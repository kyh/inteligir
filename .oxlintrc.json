{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc/json-schema-for-oxfmt/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "dist-electron",
    "node_modules",
    "pnpm-lock.yaml",
    "*.tsbuildinfo",
    ".next",
    ".expo",
    ".wxt",
    ".output",
    "out"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "react", "nextjs", "oxc", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // No `as` casts (`as const` stays allowed). The few legitimate
    // third-party/type-system bridges carry a one-line justification plus an
    // inline disable; everything else gets a real type, guard, or generic.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "react/react-in-jsx-scope": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    // expo-status-bar's StatusBar takes `style` as a string variant, not CSS.
    "react/style-prop-object": ["error", { "allow": ["StatusBar"] }],
    // Render props (React Navigation headerRight, FlatList renderItem) are legit.
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }]
  },
  "overrides": [
    {
      // Tests may cast at mock seams (partial doubles of wide interfaces).
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      // Dependency boundary: agent/ must stay main-free. Capabilities are
      // injected as AgentPorts from main/lib/agent-lifecycle.ts.
      "files": ["apps/desktop/src/agent/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/main", "@/main/**", "**/main/**"],
                "message": "agent/ must not import from main/ — inject via AgentPorts (main/lib/agent-lifecycle.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      // Vendored @fluid (fluidfunctionalism.com) registry components + their
      // foundations follow upstream's conventions, not our app lint rules. They
      // are third-party code we don't hand-author; exempt the rules they trip so
      // our own components stay fully linted.
      "files": [
        "packages/ui/src/components/button.tsx",
        "packages/ui/src/components/badge.tsx",
        "packages/ui/src/components/dialog.tsx",
        "packages/ui/src/components/switch.tsx",
        "packages/ui/src/components/tabs.tsx",
        "packages/ui/src/components/chat-message.tsx",
        "packages/ui/src/components/file-thumbnail.tsx",
        "packages/ui/src/lib/springs.ts",
        "packages/ui/src/lib/surface-context.tsx",
        "packages/ui/src/lib/surface-classes.ts",
        "packages/ui/src/lib/shape-context.tsx",
        "packages/ui/src/lib/icon-context.tsx",
        "packages/ui/src/lib/icon-map.tsx",
        "packages/ui/src/lib/font-weight.ts",
        "packages/ui/src/hooks/use-proximity-hover.ts"
      ],
      "rules": {
        "typescript/consistent-type-assertions": "off",
        "typescript/triple-slash-reference": "off",
        "promise/always-return": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-object-type-as-default-prop": "off",
        "react/no-array-index-key": "off",
        "react/no-unstable-nested-components": "off",
        "react-hooks/exhaustive-deps": "off",
        "oxc/no-map-spread": "off",
        "unicorn/no-array-sort": "off"
      }
    }
  ]
}
