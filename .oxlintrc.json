{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc/json-schema-for-oxfmt/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    "*.tsbuildinfo",
    ".output",
    ".tanstack",
    "out",
    "routeTree.gen.ts",
    "worker-configuration.d.ts",
    ".design-sync",
    ".ds-sync",
    ".expo",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "apps/desktop/resources/html-app-runtime/tailwind.global.js",
    "apps/desktop/resources/html-app-runtime/alpine.min.js"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "react", "oxc", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "react/react-in-jsx-scope": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": ["packages/domain/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "electron",
                  "electron/*",
                  "react",
                  "react-dom",
                  "react/*",
                  "@repo/bridge",
                  "@repo/bridge/*",
                  "@repo/cli-bootstrap",
                  "@repo/cli-bootstrap/*",
                  "@repo/backend",
                  "@repo/backend/*",
                  "@repo/ui",
                  "@repo/ui/*",
                  "@repo/desktop",
                  "@repo/desktop/*"
                ],
                "message": "@repo/domain is pure and platform-neutral — no node/electron/react/workspace imports; callers inject platform capabilities (see sync/engine.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/bridge/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron", "electron/*", "node:*", "@repo/desktop", "@repo/desktop/*"],
                "message": "@repo/bridge is the isomorphic wire contract — no node/electron imports (the node backend lives in @repo/backend/server)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/backend/src/server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/*",
                  "electron-updater",
                  "@repo/desktop",
                  "@repo/desktop/*",
                  "**/apps/desktop/**"
                ],
                "message": "the features backend is platform-agnostic — no electron/desktop imports; inject via HostPlatform (src/server/platform.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/agent/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/*",
                  "@repo/backend",
                  "@repo/backend/*",
                  "@repo/desktop",
                  "@repo/desktop/*"
                ],
                "message": "@repo/agent must not reach into the backend or the shell — the host injects capabilities via AgentPorts (extension.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/**", "apps/desktop/dev/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/*",
                  "electron-updater",
                  "node:*",
                  "@repo/backend/*",
                  "@repo/backend",
                  "@/main",
                  "@/main/*",
                  "@/preload",
                  "@/preload/*"
                ],
                "message": "the renderer UI is host-agnostic — no electron/node/backend/main imports; reach the backend through the injected Bridge (@renderer/lib/bridge)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/__tests__/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
