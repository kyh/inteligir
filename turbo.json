{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  // worktrees share one cache dir and turbo never evicts by default; eviction runs in the
  // background at the start of `turbo run`
  "cacheMaxSize": "10GB",
  "cacheMaxAge": "14d",
  // Without this flag a changed file counts only for the package that holds it, and a file in no
  // workspace is the root's, which nothing depends on. With it, a file counts for every task whose
  // `inputs` name it, and the root's inputs are every file in the tree, so `verify:affected` lints
  // and knips a change in any workspace, which only the root's tasks do.
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      // tsbuildinfo is typecheck's output: declared here, it would cache the wrong artifact
      "outputs": ["dist/**"]
    },
    // `dev` never exits, so persistent: a task that depends on it is an error rather than a hang
    "dev": {
      "cache": false,
      "persistent": true
    },
    // a workspace's generated sources (the extension's `.wxt/` types and tsconfig), which its
    // typecheck and its suites both read. ^topo: wxt loads the entrypoints, which import other
    // workspaces
    "generate": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "generate"],
      // tsc runs incremental, so its state is this task's output, or every restore re-checks from
      // cold; a glob, because a workspace with several programs writes one file each
      "outputs": [".cache/tsbuildinfo*.json"]
    },
    // the shell's Rust is the one workspace with a formatter of its own (oxfmt has the rest), and
    // cargo fmt's check is quicker than a cache restore
    "format": {
      "cache": false
    },
    // the root's own checks: the root package's hash is every file in the tree, so any edit
    // anywhere misses, and an entry stored per run would never be read back
    "//#format": {
      "cache": false
    },
    // knip reads each workspace's tsconfig, and the extension's extends the one `wxt prepare`
    // writes: without it knip sees none of the extension's suites
    "//#knip": {
      "cache": false,
      "dependsOn": ["@repo/extension#generate"]
    },
    // the type-aware pass reads each workspace's program: the extension's extends what its
    // `generate` writes (`.wxt/tsconfig.json`), and the site's takes its route types from its own
    "//#lint": {
      "cache": false,
      "dependsOn": ["@repo/extension#generate", "@repo/web#generate"]
    },
    "format:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^topo", "generate"],
      // the suites run in parallel (four at once, or TEST_CONCURRENCY), so every vitest.config.ts
      // caps its own maxWorkers: uncapped pools exhaust the machine and kill workers mid-run
      "cache": false,
      // the Postgres the database suites clone theirs on (@repo/db/test-database); unset, they skip
      "passThroughEnv": ["TEST_POSTGRES_URL"]
    }
  },
  // each key packages/service/src/env.ts parses, since turbo hands a task only what is listed
  // (its suite holds the two lists equal), and NODE_ENV, hashed rather than passed through: next
  // and vite emit React's dev build under an ambient `development`, so a build run from a shell
  // that sets it would otherwise store a dev bundle under the production key in the cache every
  // worktree shares
  "globalEnv": [
    "AGENT_MOCK_MODEL",
    "AI_GATEWAY_API_KEY",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "BLOB_READ_WRITE_TOKEN",
    "CRON_SECRET",
    "EMAIL_FROM",
    "EMAIL_MODE",
    "EVE_BASE_URL",
    "FILE_STORE_DIR",
    "LIBRARY_STORAGE_CAP_BYTES",
    "MIN_CLIENT_BUILD",
    "NODE_ENV",
    "PAGE_FETCH_RELAY_URL",
    "POSTGRES_URL",
    "RATE_LIMIT_DISABLED",
    "RESEND_API_KEY"
  ],
  "globalPassThroughEnv": ["CI", "npm_lifecycle_event"]
}
