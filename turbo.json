{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**", ".next/**", "!.next/cache/**", ".output/**"]
    },
    // Static web build served by @repo/server (dist-web/, non-default
    // outDir); the cli resolves it at runtime, so `pnpm build` must emit it.
    "@repo/app#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist-web/**"]
    },
    "@repo/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", ".output/**"],
      "env": ["INTELIGIR_GOOGLE_OAUTH_CLIENT_ID", "INTELIGIR_GOOGLE_OAUTH_CLIENT_SECRET"]
    },
    // No ^dev edge: every dev script is a long-running server (electron-vite,
    // next, @repo/app's vite harness), so a dependency edge would block a
    // dependent's dev behind a server that never exits.
    "dev": {
      "cache": false,
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "globalEnv": ["PORT"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event"
  ]
}
