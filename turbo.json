{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  // worktrees share one cache dir and turbo never evicts by default; eviction runs in the
  // background at the start of `turbo run`
  "cacheMaxSize": "10GB",
  "cacheMaxAge": "14d",
  // Deploy asks `turbo query affected` whether the Worker changed. Without this flag a changed
  // file counts only for the package that holds it, and a file in no workspace is the root's,
  // which nothing depends on: an edit to docs/privacy.md alone would deploy nothing. With it, a
  // file counts for every task whose `inputs` name it (apps/web/turbo.json names the legal texts).
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      // tsbuildinfo is typecheck's output: declared here, it would cache the wrong artifact
      "outputs": ["dist/**"]
    },
    // `dev` never exits, so persistent: a task that depends on it is an error rather than a hang
    "dev": {
      "cache": false,
      "persistent": true
    },
    // a workspace's generated sources (the Worker's and the service's Env and runtime types, from
    // `cf workers types`),
    // which its typecheck and its suites both read: a test file can carry type claims too. ^topo:
    // the Env is typed from the entry's exports, which import other workspaces
    "generate": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "generate"],
      // tsc runs incremental, so its state is this task's output, or every restore re-checks from
      // cold; a glob, because a workspace with several programs writes one file each
      "outputs": [".cache/tsbuildinfo*.json"]
    },
    // the shell's Rust is the one workspace with a formatter of its own (oxfmt has the rest), and
    // cargo fmt's check is quicker than a cache restore
    "format": {
      "cache": false
    },
    // the root's own checks: the root package's hash is every file in the tree, so any edit
    // anywhere misses, and an entry stored per run would never be read back
    "//#format": {
      "cache": false
    },
    // knip reads each workspace's tsconfig, and the extension's extends the one `wxt prepare`
    // writes: without it knip sees none of the extension's suites
    "//#knip": {
      "cache": false,
      "dependsOn": ["@repo/extension#generate"]
    },
    // the type-aware pass reads each workspace's program, and the Worker's, the service's and the
    // extension's extend what their `generate` writes (the Env types, `.wxt/tsconfig.json`)
    "//#lint": {
      "cache": false,
      "dependsOn": ["@repo/web#generate", "@repo/service#generate", "@repo/extension#generate"]
    },
    "format:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^topo", "generate"],
      // the suites run in parallel (four at once, or TEST_CONCURRENCY), so every vitest.config.ts
      // caps its own maxWorkers: uncapped pools exhaust the machine and kill workers mid-run
      "cache": false,
      // the macOS CI job's opt-out of the editor's typing budget
      // (packages/editor/vitest.config.ts says why)
      "passThroughEnv": ["SKIP_TYPING_BUDGET"]
    }
  },
  // NODE_ENV is hashed, not only passed through: vite emits React's dev build under an ambient
  // `development`, so a build run from a shell that sets it would otherwise store a dev bundle
  // under the production key in the cache every worktree shares
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI", "npm_lifecycle_event"]
}
