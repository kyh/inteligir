{
  "name": "@inteligir/web",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://inteligir.com",
  "bugs": "https://github.com/kyh/inteligir/issues",
  "repository": "https://github.com/kyh/inteligir",
  "author": "Kaiyu Hsu @kyh",
  "scripts": {
    "lint": "next lint",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:migrate:dev": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' dotenv -e .env.local -- prisma migrate dev",
    "prisma:migrate:prod": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' dotenv -e .env.local -- prisma migrate deploy",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:seed": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' dotenv -e .env.local -- prisma db seed",
    "stripe:dev": "stripe listen --forward-to  http://localhost:3000/api/stripe/webhook",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "next",
      "next/core-web-vitals"
    ]
  },
  "dependencies": {
    "@headlessui/react": "^1.4.1",
    "@heroicons/react": "^1.0.4",
    "@next-auth/prisma-adapter": "^0.5.2-next.5",
    "@prisma/client": "^3.2.1",
    "@stripe/stripe-js": "^1.17.1",
    "babel-plugin-superjson-next": "^0.4.1",
    "cross-fetch": "^3.1.4",
    "dotenv-cli": "^4.0.0",
    "framer-motion": "^4.1.17",
    "next": "^11.1.2",
    "next-auth": "^4.0.0-beta.2",
    "next-connect": "^0.10.2",
    "nodemailer": "^6.6.3",
    "posthog-js": "^1.14.1",
    "prisma": "^3.2.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-icons": "^4.2.0",
    "react-query": "^3.26.0",
    "stripe": "^8.176.0",
    "superjson": "^1.7.5",
    "tailwind-styled-components": "^2.0.3",
    "tailwindcss-classnames": "^2.2.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.3.3",
    "@types/react": "^17.0.21",
    "autoprefixer": "^10.3.4",
    "eslint": "^7.32.0",
    "eslint-config-next": "^11.1.2",
    "postcss": "^8.3.6",
    "tailwindcss": "^2.2.15",
    "ts-node": "^10.2.1",
    "typescript": "^4.4.3"
  }
}
