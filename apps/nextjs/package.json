{
  "name": "@inteligir/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 next lint",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@inteligir/api": "workspace:*",
    "@inteligir/auth": "workspace:*",
    "@inteligir/db": "workspace:*",
    "@inteligir/icons": "latest",
    "@inteligir/ui": "workspace:*",
    "@tanstack/react-query": "^5.8.7",
    "@tanstack/react-query-devtools": "^5.8.7",
    "@tanstack/react-query-next-experimental": "^5.8.7",
    "@trpc/client": "next",
    "@trpc/next": "next",
    "@trpc/react-query": "next",
    "@trpc/server": "next",
    "next": "^14.0.3",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "superjson": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@inteligir/eslint-config": "workspace:*",
    "@inteligir/prettier-config": "workspace:*",
    "@inteligir/tailwind-config": "workspace:*",
    "@inteligir/tsconfig": "workspace:*",
    "@types/mdx": "^2.0.10",
    "@types/node": "^18.18.13",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@inteligir/eslint-config/base",
      "@inteligir/eslint-config/nextjs",
      "@inteligir/eslint-config/react"
    ]
  },
  "prettier": "@inteligir/prettier-config"
}
