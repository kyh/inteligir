{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inteligir",
  "mainBinaryName": "Inteligir",
  "version": "../package.json",
  "identifier": "com.inteligir.desktop",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:31000",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "frame-src": "'self'",
        "worker-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
