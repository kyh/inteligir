{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inteligir",
  "mainBinaryName": "Inteligir",
  "version": "../package.json",
  "identifier": "com.inteligir.desktop",
  "build": {
    "frontendDist": "../../workspace/dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [],
    "security": {
      "pattern": { "use": "isolation", "options": { "dir": "../isolation" } },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: inteligir-files:",
        "media-src": "'self' blob: inteligir-files:",
        "object-src": "inteligir-files:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost inteligir-files: https://inteligir.com wss://inteligir.com",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "worker-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
