{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inteligir",
  "mainBinaryName": "Inteligir",
  "version": "../package.json",
  "identifier": "com.inteligir.desktop",
  "build": {
    "devUrl": "http://localhost:5174/library",
    "frontendDist": "https://inteligir.com/library",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inteligir",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "create": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
