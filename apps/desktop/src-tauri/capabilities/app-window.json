{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-window",
  "description": "The app window's permissions, which the shell reads when it opens the window and grants for that window and the server's exact origin alone (src/window.rs), since the port is the server's to choose. This file itself grants them to no page; the build keeps every command it names.",
  "windows": ["vault-*"],
  "local": false,
  "remote": { "urls": [] },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "allow-diagnostics-get-state",
    "allow-diagnostics-open-data-folder",
    "allow-diagnostics-restart",
    "allow-diagnostics-set-debug",
    "allow-diagnostics-show-log",
    "allow-paths-open",
    "allow-paths-reveal",
    "allow-print-page",
    "allow-updates-check",
    "allow-updates-download",
    "allow-updates-get-state",
    "allow-updates-install",
    "allow-vaults-forget",
    "allow-vaults-get-state",
    "allow-vaults-open",
    "allow-vaults-pick"
  ]
}
