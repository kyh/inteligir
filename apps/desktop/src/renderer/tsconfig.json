{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    // ES2024 for the suites: the booted ones compile apps/cli's server, which runs on node. The
    // page's own ceiling is tsconfig.page.json's ES2023, the stdlib of the window's WebKit.
    "lib": ["ES2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "${configDir}/../../.cache/tsbuildinfo.renderer.json"
  },
  "include": ["."]
}
