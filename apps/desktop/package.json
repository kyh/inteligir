{
  "name": "@repo/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Inteligir desktop app",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "release": "pnpm verify:release && pnpm with-env electron-vite build && pnpm with-env electron-builder --mac dmg --publish never && pnpm verify:packaged",
    "release:publish": "pnpm verify:release && GH_TOKEN=$(gh auth token) pnpm with-env electron-vite build && GH_TOKEN=$(gh auth token) pnpm with-env electron-builder --mac dmg --publish always && pnpm verify:packaged",
    "with-env": "dotenv -e .env --",
    "clean": "rm -rf .cache .output",
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:runtime-model-registry": "node scripts/verify-runtime-model-registry.mjs",
    "verify:packaged-runtime-deps": "node scripts/verify-packaged-runtime-deps.mjs",
    "verify:release": "pnpm verify:runtime-model-registry",
    "verify:packaged": "pnpm verify:packaged-runtime-deps"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.72.1",
    "@mariozechner/pi-coding-agent": "^0.72.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@repo/agent-runtime": "workspace:^",
    "@repo/pi-driver": "workspace:^",
    "@repo/ui": "workspace:^",
    "@sinclair/typebox": "^0.34.49",
    "ai": "^6.0.105",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.3",
    "motion": "^12.38.0",
    "open": "^11.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.14.2",
    "streamdown": "^2.5.0",
    "tailwindcss": "catalog:",
    "three": "^0.184.0",
    "zod": "catalog:",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.14.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.5"
  }
}
