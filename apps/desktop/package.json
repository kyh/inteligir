{
  "name": "@repo/desktop",
  "private": true,
  "description": "The Inteligir Mac app: an Electron window on the site's library tab, with electron-updater.",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev --watch",
    "package": "electron-vite build && dotenv --no-expand -e ../../.release/release.env -- node scripts/package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
