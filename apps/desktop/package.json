{
  "name": "@repo/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Inteligir desktop app",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "release": "pnpm verify:release && pnpm with-env electron-vite build && pnpm with-env electron-builder --mac --publish never && pnpm verify:packaged",
    "release:publish": "pnpm verify:release && GH_TOKEN=$(gh auth token) pnpm with-env electron-vite build && GH_TOKEN=$(gh auth token) pnpm with-env electron-builder --mac --publish always && pnpm verify:packaged",
    "with-env": "dotenv -e .env --",
    "clean": "rm -rf .cache .output",
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:runtime-model-registry": "node scripts/verify-runtime-model-registry.mjs",
    "verify:packaged-runtime-deps": "node scripts/verify-packaged-runtime-deps.mjs",
    "verify:release": "pnpm verify:runtime-model-registry",
    "verify:packaged": "pnpm verify:packaged-runtime-deps"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.30",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.0.3",
    "@platejs/list": "^53.1.3",
    "@platejs/markdown": "^53.2.2",
    "@platejs/slash-command": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@repo/agent-runtime": "workspace:^",
    "@repo/pi-driver": "workspace:^",
    "@repo/ui": "workspace:^",
    "@sinclair/typebox": "catalog:",
    "ai": "^6.0.191",
    "electron-updater": "^6.8.3",
    "lowlight": "^3.3.0",
    "lucide-react": "catalog:",
    "open": "^11.0.0",
    "platejs": "^53.2.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sherpa-onnx-node": "^1.10.41",
    "tar": "^7.5.15",
    "unbzip2-stream": "^1.4.3",
    "unified": "^11.0.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.73.1",
    "@tailwindcss/vite": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unbzip2-stream": "^1.4.3",
    "@vitejs/plugin-react": "catalog:",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "^1.13.2",
    "sherpa-onnx-darwin-x64": "^1.13.2",
    "sherpa-onnx-linux-arm64": "^1.13.2",
    "sherpa-onnx-linux-x64": "^1.13.2",
    "sherpa-onnx-win-ia32": "^1.13.2",
    "sherpa-onnx-win-x64": "^1.13.2"
  }
}
