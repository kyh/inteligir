{
  "name": "@repo/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Inteligir desktop shell",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "release": "pnpm verify:release && pnpm with-env electron-vite build && pnpm with-env electron-builder --mac --publish never",
    "release:publish": "pnpm verify:release && GH_TOKEN=$(gh auth token) pnpm with-env electron-vite build && GH_TOKEN=$(gh auth token) pnpm with-env electron-builder --mac --publish always",
    "with-env": "dotenv -e .env --",
    "clean": "rm -rf .cache .output",
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:release": "pnpm -w verify"
  },
  "dependencies": {
    "@repo/bridge": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
