{
  "name": "@repo/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Inteligir desktop app",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "release": "pnpm verify:release && pnpm with-env electron-vite build && pnpm with-env electron-builder --mac --publish never && pnpm verify:packaged",
    "release:publish": "pnpm verify:release && GH_TOKEN=$(gh auth token) pnpm with-env electron-vite build && GH_TOKEN=$(gh auth token) pnpm with-env electron-builder --mac --publish always && pnpm verify:packaged",
    "with-env": "dotenv -e .env --",
    "clean": "rm -rf .cache .output",
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "dev:harness": "vite --config vite.harness.config.ts",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:runtime-model-registry": "node scripts/verify-runtime-model-registry.mjs",
    "verify:packaged-runtime-deps": "node scripts/verify-packaged-runtime-deps.mjs",
    "verify:release": "pnpm verify:runtime-model-registry",
    "verify:packaged": "pnpm verify:packaged-runtime-deps"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "^6.3.1",
