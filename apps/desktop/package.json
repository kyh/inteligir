{
  "name": "@repo/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "The Inteligir desktop shell: a Tauri window over the local server's own page, supervising that server as a child process.",
  "author": "kyh",
  "type": "module",
  "scripts": {
    "build:shell": "tauri build --debug --no-bundle",
    "dev": "tauri dev",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "package": "node scripts/package.ts",
    "smoke": "node scripts/smoke-packaged.ts",
    "tauri": "tauri",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p scripts && cargo clippy --locked --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@repo/contract": "workspace:*",
    "@repo/workspace": "workspace:*",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "catalog:",
    "inteligir": "workspace:*",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
