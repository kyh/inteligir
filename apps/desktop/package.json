{
  "name": "@repo/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "The Inteligir desktop shell: a Tauri window over the local server's own page, supervising that server as a child process.",
  "author": "kyh",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode first-run",
    "build:shell": "tauri build --debug --no-bundle",
    "dev": "tauri dev",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "package": "node scripts/fetch-git.mjs && node scripts/fetch-node.mjs && node scripts/package.mjs",
    "smoke": "node scripts/smoke-packaged.mjs",
    "tauri": "tauri",
    "test": "vitest run && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/renderer && tsc --noEmit -p src/renderer/tsconfig.page.json && cargo clippy --locked --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@repo/contract": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/editor": "workspace:*",
    "@repo/notes": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "inteligir": "workspace:*",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "oxc-transform-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}
