{
  "name": "@repo/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "The Inteligir Mac app: a Tauri window over the library's page the bundle carries, with the account's replica, its credential and its files in Rust.",
  "author": "kyh",
  "type": "module",
  "scripts": {
    "build:shell": "tauri build --debug --no-bundle --config src-tauri/tauri.local.conf.json",
    "dev": "tauri dev --no-dev-server --config src-tauri/tauri.local.conf.json",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "package": "node scripts/package.ts",
    "smoke": "node scripts/smoke-packaged.ts",
    "tauri": "tauri",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p scripts && cargo clippy --locked --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@repo/workspace": "workspace:*",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
