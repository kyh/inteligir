    "electron-updater": "^6.8.3",
    "framer-motion": "^12.42.1",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "lucide-react": "catalog:",
    "mermaid": "^11.16.0",
    "nanoid": "^5.1.11",
    "platejs": "^53.2.4",
    "react": "catalog:",
    "react-day-picker": "^9.14.0",
