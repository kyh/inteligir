{
  "name": "@repo/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Inteligir desktop app",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "release": "pnpm verify:release && pnpm with-env electron-vite build && pnpm with-env electron-builder --mac dmg --publish never && pnpm verify:packaged",
    "release:publish": "pnpm verify:release && GH_TOKEN=$(gh auth token) pnpm with-env electron-vite build && GH_TOKEN=$(gh auth token) pnpm with-env electron-builder --mac dmg --publish always && pnpm verify:packaged",
    "with-env": "dotenv -e .env --",
    "clean": "rm -rf .cache .output",
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:runtime-model-registry": "node scripts/verify-runtime-model-registry.mjs",
    "verify:packaged-runtime-deps": "node scripts/verify-packaged-runtime-deps.mjs",
    "verify:release": "pnpm verify:runtime-model-registry",
    "verify:packaged": "pnpm verify:packaged-runtime-deps"
  },
  "dependencies": {
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@repo/agent-runtime": "workspace:^",
    "@repo/dispatch": "workspace:^",
    "@repo/pi-driver": "workspace:^",
    "@repo/ui": "workspace:^",
    "@sinclair/typebox": "catalog:",
    "ai": "^6.0.191",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "catalog:",
    "open": "^11.0.0",
    "partysocket": "^1.1.19",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-grid-layout": "^2.2.3",
    "react-router": "^7.15.1",
    "sherpa-onnx-node": "^1.10.41",
    "tar": "^7.5.15",
    "unbzip2-stream": "^1.4.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "^1.13.2",
    "sherpa-onnx-darwin-x64": "^1.13.2",
    "sherpa-onnx-linux-arm64": "^1.13.2",
    "sherpa-onnx-linux-x64": "^1.13.2",
    "sherpa-onnx-win-ia32": "^1.13.2",
    "sherpa-onnx-win-x64": "^1.13.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@mariozechner/pi-ai": "^0.73.1",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unbzip2-stream": "^1.4.3",
    "@vitejs/plugin-react": "catalog:",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.7"
  }
}
