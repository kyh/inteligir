{
  // node runs these files itself, stripping their types, so the program resolves as node does and
  // refuses the syntax stripping cannot erase: an extensionless import or an enum here typechecks
  // under the bundler resolution the rest of the repo uses, then throws at the first run.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "nodenext",
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "${configDir}/../.cache/tsbuildinfo.scripts.json"
  },
  "include": ["."]
}
