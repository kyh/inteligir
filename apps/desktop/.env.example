# Copy to apps/desktop/.env (gitignored — NEVER commit real values).
#
# How it's loaded:
# - Dev: `pnpm dev:desktop` reads INTELIGIR_APP_URL from the shell environment.
#   Export it, or use `pnpm with-env` if you'd rather keep it here.
# - Release: `release` / `release:publish` run under `pnpm with-env`
#   (dotenv -e .env), so build-time `define` injection and electron-builder
#   notarization both see this file.

# --- Which deployment this shell wraps ---------------------------------------
# Baked into the main bundle at build time, and read again at runtime (runtime
# wins). Leave empty to ship pointing at https://inteligir.com. Anything that
# is not an http(s) URL is refused rather than coerced — the window loads
# exactly one origin and is pinned to it.
INTELIGIR_APP_URL=

# --- Apple notarization (release builds, required) ---------------------------
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
