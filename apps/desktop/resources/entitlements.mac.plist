<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened-runtime entitlements, and every one of them is here because
  something needs it: an entitlement carried "just in case" is a permission the
  shipped app really holds.

  Deliberately ABSENT: automation.apple-events (the shell scripts no other
  app) and cs.disable-library-validation (it lets the process load unsigned
  dylibs; the only native code here is loaded by the server child from inside
  the signed bundle).
-->
<plist version="1.0">
<dict>
  <!-- V8 compiles JavaScript at runtime; Electron does not start without these. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The window talks to the local server over loopback HTTP and a websocket,
       and the vault's git sync dials a remote. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Dictation streams the microphone to the local server; without this the
       hardened runtime denies getUserMedia and macOS kills the process. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
