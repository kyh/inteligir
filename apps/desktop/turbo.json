{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // `inteligir` is packed into the app from node_modules and spawned as a
    // child, never imported, so the ordering is named rather than inherited
    // through `^build`.
    "build": {
      "dependsOn": ["inteligir#build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // turbo runs in strict env mode and strips anything unnamed. The shell
      // resolves its target through the APP's own `resolveAppConfig`, so the
      // set it needs is that module's whole table and not the port alone —
      // stripping INTELIGIR_DATA_DIR alone would have the window verify a
      // responder's identity against the wrong data directory. Held against
      // `ENV_VAR_NAMES` by tools/repo-guards/src/turbo-passthrough.test.ts,
      // which derives its scope from who calls that function.
      "passThroughEnv": [
        "INTELIGIR_AGENT",
        "INTELIGIR_AGENT_MODEL",
        "INTELIGIR_CLOUD_URL",
        "INTELIGIR_DATA_DIR",
        "INTELIGIR_HMR_PORT",
        "INTELIGIR_PORT",
        "INTELIGIR_SYNC_INTERVAL_MS",
        "INTELIGIR_VAULT_DIR",
        "INTELIGIR_VAULT_REMOTE"
      ]
    }
  }
}
