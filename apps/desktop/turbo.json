{
  "$schema": "https://turbo.build/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".output/**"]
    },
    // `INTELIGIR_APP_URL` is how a local shell is pointed at `pnpm dev:web`, and
    // turbo runs in strict env mode — a variable named nowhere is stripped
    // before the task sees it, so the shell would silently load production.
    // passThroughEnv rather than env: `dev` is uncached, so this is a
    // pass-through rather than a hash input (`#build` declares it as an input,
    // where it is baked into the bundle).
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["INTELIGIR_APP_URL"]
    }
  }
}
