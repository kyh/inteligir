{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.config.json"
  },
  "include": ["vite.config.ts", "vitest.config.ts"],
  // `src` is the page and its own program (src/renderer/tsconfig.json): it type-checks against the
  // DOM and React rather than @types/node, and reaches the shared states beside it (src/*.ts) by
  // import. The shell is Rust (src-tauri), checked by clippy. `pnpm typecheck` runs all three.
  "exclude": ["node_modules", "dist", "src", "src-tauri"]
}
