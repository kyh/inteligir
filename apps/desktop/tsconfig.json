{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["./src/*"],
      "@repo/app": ["../../packages/app/src/index.ts"],
      "@repo/app/*": ["../../packages/app/src/*"],
      "@repo/core/*": ["../../packages/core/src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src/**/*", "electron.vite.config.ts"],
  // `exclude` replaces (not merges with) the base list, so the base entries
  // are repeated here.
  "exclude": ["node_modules", "build", "dist", ".next", ".expo", ".output"]
}
