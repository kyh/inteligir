{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["./src/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "dev/**/*",
    "electron.vite.config.ts",
    "vite.harness.config.ts",
    "vitest.config.ts",
    "../../packages/backend/src/server/voice/sherpa-onnx-node.d.ts"
  ],
  "exclude": ["node_modules", "build", "dist", ".output", "src/renderer/voice/stt-worklet.js"]
}
