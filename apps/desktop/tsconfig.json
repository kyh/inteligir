{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.config.json"
  },
  "include": ["vite.config.ts", "vitest.config.ts"],
  // `src` is the page and its own programs (src/renderer/tsconfig.json with its suites, and
  // tsconfig.page.json at the window's stdlib): they type-check against the DOM and React rather
  // than @types/node, and reach the shared states beside them (src/*.ts) by import. The shell is
  // Rust (src-tauri), checked by clippy. `pnpm typecheck` runs all four.
  "exclude": ["node_modules", "dist", "src", "src-tauri"]
}
