{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The licence texts it stages sit at the repo root, in no workspace,
      // so turbo hashes them only where they are named.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/licenses/**"]
    }
  }
}
