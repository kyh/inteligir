{
  "name": "inteligir",
  "version": "0.6.0",
  "description": "The `inteligir` binary: `serve` runs the whole local server — the agent threads, their sync and the API — and every other verb is an oRPC client against a running one. Every leaf takes --json.",
  "keywords": [
    "agent",
    "local-first"
  ],
  "homepage": "https://github.com/kyh/inteligir#readme",
  "bugs": {
    "url": "https://github.com/kyh/inteligir/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyh/inteligir.git",
    "directory": "apps/cli"
  },
  "bin": {
    "inteligir": "./bin/inteligir"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    "./server/cloud/credential-store": "./src/server/cloud/credential-store.ts",
    "./server/cloud/sync-cadence": "./src/server/cloud/sync-cadence.ts",
    "./server/config": "./src/server/config.ts",
    "./server/csp": "./src/server/csp.ts",
    "./server/debug-log": "./src/server/debug-log.ts",
    "./server/dev-instance": "./src/server/dev-instance.ts",
    "./server/local-client": "./src/server/local-client.ts",
    "./server/server-file": "./src/server/server-file.ts",
    "./server/server-probe": "./src/server/server-probe.ts",
    "./server/shutdown": "./src/server/shutdown.ts",
    "./server/staged-write": "./src/server/staged-write.ts",
    "./server/testing": "./src/server/__tests__/boot-app.ts"
  },
  "publishConfig": {
    "exports": {},
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@repo/contract": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@types/node": "catalog:",
    "citty": "catalog:",
    "consola": "catalog:",
    "esbuild": "catalog:",
    "hono": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
