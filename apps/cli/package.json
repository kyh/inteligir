{
  "name": "inteligir",
  "version": "0.6.0",
  "description": "The `inteligir` binary: `serve` runs the whole local server — vault, index, agent, API — and every other verb is an oRPC client against a running one. Agent-facing by design: every leaf takes --json, the server serves the manual, and agent shells get INTELIGIR_DATA_DIR/INTELIGIR_THREAD_ID injected.",
  "keywords": [
    "agent",
    "local-first",
    "markdown",
    "notes",
    "obsidian",
    "vault"
  ],
  "homepage": "https://github.com/kyh/inteligir#readme",
  "bugs": {
    "url": "https://github.com/kyh/inteligir/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyh/inteligir.git",
    "directory": "apps/cli"
  },
  "bin": {
    "inteligir": "./bin/inteligir"
  },
  "files": [
    "bin",
    "dist",
    "seed",
    "README.md",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    "./desktop/door-answers": "./src/desktop/__tests__/door-answers.ts",
    "./server/agent-shell-env": "./src/server/agents/agent-shell-env.ts",
    "./server/cloud/credential-store": "./src/server/cloud/credential-store.ts",
    "./server/cloud/sync-cadence": "./src/server/cloud/sync-cadence.ts",
    "./server/config": "./src/server/config.ts",
    "./server/csp": "./src/server/csp.ts",
    "./server/dev-instance": "./src/server/dev-instance.ts",
    "./server/path-containment": "./src/server/path-containment.ts",
    "./server/server-file": "./src/server/server-file.ts",
    "./server/server-probe": "./src/server/server-probe.ts",
    "./server/shutdown": "./src/server/shutdown.ts",
    "./server/vault-switch": "./src/server/vault-switch.ts",
    "./server/testing": "./src/server/__tests__/boot-app.ts",
    "./server/ui-dev-server": "./src/server/ui-dev-server.ts",
    "./server/vault/seed-vault": "./src/server/vault/seed-vault.ts",
    "./scripts/smoke-lib": "./scripts/smoke-lib.ts"
  },
  "publishConfig": {
    "exports": {},
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@agentclientprotocol/codex-acp": "catalog:",
    "@parcel/watcher": "catalog:",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@repo/agent-runtime": "workspace:*",
    "@repo/agent-skills": "workspace:*",
    "@repo/contract": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/notes": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "citty": "catalog:",
    "consola": "catalog:",
    "esbuild": "catalog:",
    "hono": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
