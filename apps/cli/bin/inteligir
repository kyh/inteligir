#!/usr/bin/env node
// A NODE bin (ESM — this package is `type: module`), not a `sh` script, so
// `npx inteligir` works on native Windows too: there is no `/bin/sh` there, and
// npm's Windows cmd-shim runs a node bin directly. The file stays EXTENSIONLESS
// so the agent's shell finds it as the bare command `inteligir` on the PATH the
// runtime prepends (agent-shell-env.ts) — a `.cjs` name would break that.
//
// Node resolves this file's realpath through the `node_modules/.bin` symlink,
// so `import.meta.url` is the package's own bin dir with no manual following.
//
// In a checkout, run the SOURCE under tsx — a stale `dist/` must never shadow
// fresh edits. The published artifact ships no `src/`, so there it runs the
// bundle, and the ARTIFACT is production: NODE_ENV is stated here rather than
// inherited, because a Finder or npx launch sets none and the mode decides the
// vault location (a missing one lands a zero-install run in a cwd-keyed dev
// instance).
//
// The real entry is a CHILD, and signals are FORWARDED to it: Ctrl+C and an
// explicit SIGTERM both reach the server's ordered shutdown (the vault flush),
// and this mirror-exits with the child's own code — 128+n when the child died
// by signal n.

import { spawn } from "node:child_process";
import { existsSync } from "node:fs";
import { constants } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const binDir = dirname(fileURLToPath(import.meta.url));
const srcEntry = join(binDir, "..", "src", "index.ts");
const args = process.argv.slice(2);

/** tsx's own CLI module, resolved through its exports map — never the
 *  `node_modules/.bin` shim. Node refuses to spawn a `.cmd` without a shell
 *  (CVE-2024-27980), so the Windows shim always throws EINVAL; running the
 *  module under THIS node is one spelling that works on every platform. Null
 *  when tsx is absent, which is the published artifact. */
function resolveTsxCli() {
  try {
    return fileURLToPath(import.meta.resolve("tsx/cli"));
  } catch {
    return null;
  }
}

const tsxCli = existsSync(srcEntry) ? resolveTsxCli() : null;
const useSource = tsxCli !== null;
const commandArgs = useSource
  ? [tsxCli, srcEntry, ...args]
  : [join(binDir, "..", "dist", "index.js"), ...args];
const env = useSource ? process.env : { ...process.env, NODE_ENV: "production" };

const child = spawn(process.execPath, commandArgs, { stdio: "inherit", env, windowsHide: true });

for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(signal, () => child.kill(signal));
}

child.on("exit", (code, signal) => {
  // A child killed by a signal exits this wrapper 128+n — the encoding a
  // shell reports and Node's own default signal handlers use — NEVER by
  // re-raising the signal at this process: with the relay handlers above
  // installed, a re-raised relayed signal runs the relay against a dead
  // child and the wrapper exits 0, and one outside the relayed set (a
  // native SIGABRT, an OOM kill) would take this wrapper down with a core
  // dump of its own. The exit code is the truth about the child.
  if (signal) {
    const signalNumber = constants.signals[signal];
    process.exit(signalNumber === undefined ? 1 : 128 + signalNumber);
    return;
  }
  process.exit(code === null ? 1 : code);
});

child.on("error", (error) => {
  process.stderr.write(`inteligir: failed to start (${error.message})\n`);
  process.exit(1);
});
