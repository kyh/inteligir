{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // the workspace UI's suites compile its page and this server together: the DOM for the one,
    // ES2024 for the other, which runs on node. The page's own programs are apps/workspace's.
    "lib": ["ES2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "${configDir}/../../.cache/tsbuildinfo.workspace.json"
  },
  "include": ["."]
}
