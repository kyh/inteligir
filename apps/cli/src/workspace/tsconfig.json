{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // the suites that hold the editor's browser-side serializer to this server's seed and its
    // placement: the DOM for the one, ES2024 for the other, which runs on node
    "lib": ["ES2024", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "tsBuildInfoFile": "${configDir}/../../.cache/tsbuildinfo.workspace.json"
  },
  "include": ["."]
}
