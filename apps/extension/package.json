{
  "name": "@repo/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode dev && vite build --config vite.capture.config.ts --mode dev",
    "dev": "node scripts/dev.ts",
