{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      // turbo runs in strict env mode and strips anything unnamed, so the
      // data-dir/port overrides must be declared to reach the dev process.
      "passThroughEnv": ["INTELIGIR_DATA_DIR", "INTELIGIR_PORT"]
    },
    // Two tsc programs (UI + node entry, see tsconfig.json), so two incremental
    // files — the root task's single-file output would cache half the work.
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/tsbuildinfo*.json"]
    }
  }
}
