{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ES2023, @repo/editor's own ceiling: the editor is most of what this page bundles, and the
    // phone's WebKit from iOS 16.4 has no ES2024 builtin (Promise.withResolvers came in 17.4).
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "vite", "vite.config.ts", "vitest.config.ts"]
}
