{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:registry": "tsx --tsconfig ./scripts/tsconfig.scripts.json scripts/build-registry.mts",
    "build:tw": "bun tailwindcss -i ./src/app/globals.css -o ./public/css/tailwind.css --minify",
    "check": "bun lint && bun typecheck",
    "db:deploy": "bun with-env prisma migrate deploy",
    "db:generate": "bun with-env prisma generate",
    "db:migrate:squash": "rm -rf prisma/migrations && bun with-env prisma migrate dev --name init",
    "db:push": "bun with-env prisma db push",
    "db:reset": "bun with-env prisma migrate reset --force && bun with-env prisma db push --accept-data-loss",
    "db:script": "bun with-env tsx prisma/scripts/script.ts",
    "db:seed": "bun with-env prisma db seed",
    "db:studio": "bun with-env prisma studio",
    "dev": "mprocs",
    "dev:app": "next dev",
    "dev:db": "docker-compose up",
    "dev:yjs": "bun with-env tsx watch src/server/yjs/server.ts",
    "docker": "docker-compose -f docker-compose.web.yml --env-file .env.local up --build",
    "postinstall": "bunx skiller@latest apply && next typegen && bun db:generate",
    "lint": "biome check && eslint --max-warnings 0",
    "lint:fix": "biome check --write",
    "migrate": "bun with-env prisma migrate dev",
    "nuke": "rimraf '**/node_modules'",
    "scheduled": "node tooling/clearFiles.js",
    "start": "run-p start:*",
    "start:app": "next start --port 3000",
    "start:yjs": "bun with-env tsx src/server/yjs/server.ts",
    "sync:plate": "node tooling/sync-plate.cjs",
    "sync:potion-ui": "node tooling/sync-potion-ui.cjs",
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "vendor": "sh tooling/vendor.sh",
    "with-env": "dotenv -e .env.local --"
  },
  "dependencies": {
