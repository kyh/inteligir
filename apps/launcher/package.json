{
  "name": "inteligir",
  "version": "0.1.0",
  "description": "An AI-native notes app — Obsidian with an agent. `npx inteligir` runs the whole product on your machine: your markdown vault, the local server and the UI.",
  "keywords": [
    "agent",
    "local-first",
    "markdown",
    "notes",
    "obsidian",
    "vault"
  ],
  "homepage": "https://github.com/kyh/inteligir#readme",
  "bugs": {
    "url": "https://github.com/kyh/inteligir/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyh/inteligir.git",
    "directory": "apps/launcher"
  },
  "bin": {
    "inteligir": "./dist/inteligir.mjs",
    "inteligir-cli": "./dist/apps/cli/bin/inteligir"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@parcel/watcher": "catalog:",
    "@zed-industries/claude-code-acp": "catalog:",
    "@zed-industries/codex-acp": "catalog:",
    "better-sqlite3": "catalog:",
    "sherpa-onnx-node": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
