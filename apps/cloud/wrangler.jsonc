{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inteligir-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Better Auth's crypto paths (password hashing, token signing) need node
  // built-ins on workerd — every Cloudflare worker that runs Better Auth sets
  // this. Without it the failure is a latent runtime one that passes typecheck.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // One Durable Object per vault: the source of truth for that vault's manifest
  // (path -> version) + generation counter. Addressed by `idFromName(vaultId)`.
  "durable_objects": {
    "bindings": [{ "name": "VaultCoordinator", "class_name": "VaultCoordinator" }],
  },
  // SQLite-backed storage for the manifest table + generation meta.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultCoordinator"] }],

  // R2 holds the raw file bytes, keyed `${vaultId}/${path}`. The manifest (in the
  // DO) is authoritative for versions/hashes; R2 is just the blob store.
  "r2_buckets": [{ "binding": "VAULT_FILES", "bucket_name": "inteligir-vault-files" }],

  // D1 (SQLite) backs Better Auth (user/session/account/verification) + the
  // `vault_owner` ownership table. `database_id` is filled in at deploy time
  // (`wrangler d1 create inteligir-auth` prints it). Migrations live in
  // src/db/migrations (drizzle-kit generated); `wrangler d1 migrations apply`
  // runs them, and the vitest Workers pool applies the same SQL in tests.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inteligir-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations",
    },
  ],

  // No `vars`: the Better Auth baseURL is derived per-request from the incoming
  // request origin (so localhost/preview/prod all work with no config), and
  // AUTH_SECRET + any OAuth client secrets are secrets — set them with
  // `wrangler secret put` (see README), never committed here.
}
