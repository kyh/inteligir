  {
    "description": "Saves a web address as an item, optionally titled, tagged, filed and with a note. A link the library already holds keeps its item, which gains the tags and moves only to a folder named here; the page is read in the background.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "folder": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "note": {
          "type": "string",
          "maxLength": 1000000
        },
        "savedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "tags": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "url": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "type": "object",
      "required": [
        "url"
      ]
    },
    "name": "save_link"
  },
  {
    "description": "Searches item titles, notes, saved articles and highlights, with optional kind, tag, folder and saved-date filters, best matches first, with a cursor for the next page.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "folderId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "kinds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "note",
              "link",
              "video",
              "audio",
              "image",
              "pdf",
              "file"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "responseFormat": {
          "type": "string",
          "enum": [
            "concise",
            "detailed"
          ]
        },
        "savedAfter": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "savedBefore": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "tag": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "type": "object",
      "required": [
        "query"
      ]
    },
    "name": "search_library"
  }
]
