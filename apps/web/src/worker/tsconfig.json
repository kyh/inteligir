{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // the generated Env is in `include`: other tools read a relative `types` path as a package
    "types": [],
    // in apps/web/.cache, which the typecheck task's outputs name
    "tsBuildInfoFile": "${configDir}/../../.cache/tsbuildinfo.worker.json",
    // highlight.js's declarations would load the DOM's lib into a workerd program
    "paths": {
      "highlight.js": ["../../../../packages/service/src/types/highlight-js.d.ts"]
    },
    // the generated Env reaches cloudflare.config.ts, which imports by `.ts`
    "allowImportingTsExtensions": true
  },
  "include": [
    ".",
    "../../.cloudflare/types/index.d.ts",
    "../../../../packages/service/src/types/sql-modules.d.ts"
  ],
  "exclude": ["node_modules"]
}
