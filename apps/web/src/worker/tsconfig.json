{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // No DOM: this half runs on workerd, whose generated globals (Request,
    // Response, BufferSource, crypto) are the ones that must win. See the note
    // in ../../tsconfig.json for why the two programs cannot be merged.
    "lib": ["ES2023"],
    // the generated Env is listed in `include`, not here: a relative path in
    // `types` reads as a package name to anything that resolves this config
    // without tsc's rules.
    "types": [],
    // The site program's `${configDir}` resolves to apps/web, so an unqualified
    // inherited path would have both tsc runs sharing one incremental file and
    // re-checking from cold every time.
    "tsBuildInfoFile": "${configDir}/../../.cache/tsbuildinfo.worker.json",
    // every @repo/service module server.ts reaches is checked here against the deployed Env, and
    // the codec's highlight.js types would load the DOM's lib into it, so they are mapped to the
    // service's stub (packages/service/src/types/highlight-js.d.ts)
    "paths": {
      "highlight.js": ["../../../../packages/service/src/types/highlight-js.d.ts"]
    },
    // the generated Env reaches cloudflare.config.ts, which names its imports by their `.ts`
    "allowImportingTsExtensions": true
  },
  "include": [".", "../../.cloudflare/types/index.d.ts"],
  "exclude": ["node_modules"]
}
