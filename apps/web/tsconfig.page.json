{
  // The pages alone, at the stdlib the Mac app's window has: the system WebKit at the macOS 13.5
  // floor is Safari 16.6's, and Vite lowers syntax, never stdlib, so an ES2024 builtin would
  // typecheck under tsconfig.json and then throw there. No node types either: no page runs on node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.page.json"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/worker",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/test-support"
  ]
}
