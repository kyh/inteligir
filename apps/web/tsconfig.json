{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // the Mac app's WebKit 16.6 stdlib: the build lowers syntax, never stdlib
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "agent", "scripts", "*.ts", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
