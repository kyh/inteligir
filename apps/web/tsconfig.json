{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["vite/client", "@cloudflare/workers-types/2023-07-01"]
  },
  "include": ["src", "env.d.ts", "vite.config.ts"],
  "exclude": ["node_modules"]
}
