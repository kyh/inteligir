{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // the Mac app's WebKit 16.6 stdlib: Vite lowers syntax, never stdlib
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  // workerd's and the DOM's globals clash, so src/worker is a program of its own
  "exclude": ["node_modules", "dist", ".wrangler", ".tanstack", "src/worker"]
}
