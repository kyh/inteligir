{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inteligir-web",
  // the file path, not `@tanstack/react-start/server-entry`: the package export builds
  // Start's default entry and drops the API routes (cloudflare/workers-sdk#11100)
  "main": "./src/worker/server.ts",
  // the oldest workerd the lockfile resolves; a guard holds it there
  "compatibility_date": "2026-08-15",
  // Better Auth's crypto needs node built-ins; without it the failure is runtime-only
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "inteligir.com/*", "zone_name": "inteligir.com" },
    { "pattern": "www.inteligir.com/*", "zone_name": "inteligir.com" },
  ],

  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },

  // append a tag per change; never edit a shipped tag
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VaultCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["UserHost"] },
    { "tag": "v3", "deleted_classes": ["VaultCoordinator"] },
    { "tag": "v4", "new_sqlite_classes": ["AgentSandbox"] },
    { "tag": "v5", "deleted_classes": ["UserHost", "AgentSandbox"] },
    { "tag": "v6", "new_sqlite_classes": ["ThreadSyncDO"] },
    { "tag": "v7", "new_sqlite_classes": ["RepoCell", "Registry"] },
  ],

  // REPO and REGISTRY are durable-git's own classes, re-exported through the entry
  "durable_objects": {
    "bindings": [
      { "name": "THREAD_SYNC", "class_name": "ThreadSyncDO" },
      { "name": "REPO", "class_name": "RepoCell" },
      { "name": "REGISTRY", "class_name": "Registry" },
    ],
  },

  // pack bytes only; without it durable-git stores packs in the cell's SQLite, which
  // caps vault size. create once: `npx wrangler r2 bucket create inteligir-vault`
  "r2_buckets": [{ "binding": "PACK_CACHE", "bucket_name": "inteligir-vault" }],

  // schema is src/worker/db/schema.ts, applied with drizzle-kit push (no migration files)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inteligir-auth",
      "database_id": "005d0e52-f102-4298-8da9-492b672ed00f",
    },
  ],

  // password-reset transport; needs `wrangler email sending enable` + DNS onboarding once
  "send_email": [{ "name": "EMAIL" }],

  // no `secrets` block: once it exists, .dev.vars is filtered down to the names in it
  // and every other key reads undefined in `vite dev`. src/worker/env.d.ts declares Env.
}
