{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // /privacy and /terms bundle docs/privacy.md and docs/terms.md, which sit in no workspace,
      // so turbo hashes them only where they are named.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/privacy.md", "$TURBO_ROOT$/docs/terms.md"],
      // The Cloudflare plugin also writes `.wrangler/deploy/config.json`, the
      // redirect `wrangler deploy` and `vite preview` follow to the built
      // worker. A cache hit that restored dist/ alone would leave them on
      // wrangler.jsonc, whose `main` is the TypeScript source.
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    }
  }
}
