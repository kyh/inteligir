{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // the licences page is gitignored, so a cache hit that left it out would serve a 404
      // eve's build is the agent `next start` serves
      "outputs": [
        ".next/**",
        ".output/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "next-env.d.ts",
        "public/licenses.md"
      ]
    },
    // next typegen writes the route types and next-env.d.ts the program includes
    "generate": {
      "outputs": [".next/types/**", "next-env.d.ts"]
    }
  }
}
