{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "next-env.d.ts"]
    },
    "typecheck": {
      // next typegen writes the route types and next-env.d.ts the program includes
      "outputs": [".cache/tsbuildinfo*.json", ".next/types/**", "next-env.d.ts"]
    }
  }
}
