{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build",
    "db:export": "drizzle-kit export --dialect=sqlite --schema=./src/worker/db/schema.ts",
    "db:push": "drizzle-kit push --config drizzle.config.local.ts --force",
    "db:push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "db:studio": "drizzle-kit studio --config drizzle.config.local.ts",
    "db:studio:remote": "dotenv -e ../../.env.production.local -- drizzle-kit studio",
    "dev": "cf dev",
    "start": "vite preview",
    "test": "vitest run",
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p src/worker"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/mcp": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@react-three/fiber": "^9.8.1",
    "@repo/contract": "workspace:*",
    "@repo/editor": "workspace:*",
    "@repo/notes": "workspace:*",
    "@repo/page-reader": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "durable-git": "0.0.8",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "catalog:",
    "three": "^0.186.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@kyh/tsconfig": "catalog:",
    "@libsql/client": "^0.18.0",
    "@orpc/client": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "catalog:",
    "cf": "catalog:",
    "drizzle-kit": "catalog:",
    "oxc-transform-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
