{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "agent-prompt": "node scripts/agent-prompt.ts",
    "build": "cf build",
    "db:export": "drizzle-kit export --dialect=sqlite --schema=./src/worker/db/schema.ts",
    "db:push": "drizzle-kit push --config drizzle.config.local.ts --force",
    "db:push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "db:studio": "drizzle-kit studio --config drizzle.config.local.ts",
    "db:studio:remote": "dotenv -e ../../.env.production.local -- drizzle-kit studio",
    "dev": "cf dev",
    "generate": "cf workers types",
    "og:cards": "node scripts/og-cards.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@cloudflare/workers-oauth-provider": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/mcp": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@react-three/fiber": "^9.8.2",
    "@repo/contract": "workspace:*",
    "@repo/editor": "workspace:*",
    "@repo/notes": "workspace:*",
    "@repo/page-reader": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "agents": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "catalog:",
    "three": "^0.186.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@kyh/tsconfig": "catalog:",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/client": "catalog:",
    "@repo/agent-skills": "workspace:*",
    "@repo/messages-fake": "workspace:*",
    "@repo/workspace": "workspace:*",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "cf": "catalog:",
    "drizzle-kit": "catalog:",
    "fflate": "^0.8.3",
    "playwright-core": "1.63.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
