# Copy to apps/web/.dev.vars (gitignored — NEVER commit real values).
#
# `vite dev` loads this over the bindings cloudflare.config.ts declares.
# BETTER_AUTH_SECRET and AI_GATEWAY_TOKEN are the production secrets, set with
# `cf workers secrets update` (see README.md -> Deploy). RATE_LIMIT_DISABLED
# is a text binding in cloudflare.config.ts, "false" wherever the Worker is
# deployed, and a line here overrides it for this machine only.

# Better Auth's signing key. Required — without it every /api/auth/* request
# fails. Any value works locally: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Set to "true" ONLY when a local script signs up several users from one IP —
# auth is rate-limited to 10 requests/60s per IP (see packages/service/src/auth/auth.ts).
# RATE_LIMIT_DISABLED=true

# The connector's OAuth issuer, its resource and the one Host it answers all
# follow this origin, http://localhost:5174 under `vite dev`. To reach the
# connector through a public tunnel (an assistant's servers cannot reach
# localhost), set it to the tunnel's https origin, and start `pnpm dev:web`
# with __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=<your-tunnel-host>, since vite
# answers no other host (vite.dev/config/server-options#server-allowedhosts).
# The tunnel must pass on X-Forwarded-Proto: https, as tunnels do, or the
# request reads as http and the connector, whose resource is https, says 404.
# SITE_ORIGIN=https://<your-tunnel-host>

# The scripted Messages API `pnpm dev:web` serves beside the Worker
# (tools/messages-fake, on its pinned port): no key, no model, and the mode
# every e2e scenario runs. Each turn runs the directives its message carries,
# the tools it names run by this Worker's own cell (the fake's README says
# which). A binding only `vite dev` declares, and it must name this machine.
# Unset it, and set the two below, to talk to Claude instead.
ANTHROPIC_FAKE_URL=http://127.0.0.1:5177

# The built-in agent's AI Gateway. Unset, with no fake above, the local
# Worker's agent says it can't be reached. A real one is a gateway in your own
# Cloudflare account, never production's or the previews': its provider-native
# Anthropic route, Authenticated Gateway on and its token below, and your own
# Anthropic key stored on it with Require provider credentials on, so this
# Worker holds no key. Every request names its account in `cf-aig-metadata`,
# which a spend limit split by `account` on your gateway holds each local
# account to. Nothing outside has to reach localhost: the agent's tools run in
# this Worker's own cell.
# AGENT_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<your-account-id>/<your-gateway>/anthropic
# AI_GATEWAY_TOKEN=
