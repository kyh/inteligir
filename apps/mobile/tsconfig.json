{
  // the repo's strictness, then Expo's own base over it: Metro's "react-native" export condition,
  // its jsx and module settings, and its excludes, so TypeScript checks the entry points the
  // bundler loads
  "extends": ["@kyh/tsconfig/base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    // the language Hermes runs, not Expo's ESNext, and the DOM types React Native's globals use
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleSuffixes": [".ios", ".native", ""],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "*.ts", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
