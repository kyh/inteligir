{
  "name": "@repo/mobile",
  "version": "0.4.0",
  "private": true,
  "main": "index.ts",
  "exports": {
    "./lib/compose-runtime": "./src/lib/compose-runtime.ts",
    "./lib/node-sql-driver": "./src/lib/node-sql-driver.ts",
    "./notes/attachment-files": "./src/notes/attachment-files.ts",
    "./notes/outbox-files": "./src/notes/outbox-files.ts"
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "build": "expo export --platform ios --output-dir dist",
    "hotfix": "EXPO_PUBLIC_CLOUD_URL= eas update --channel production --platform ios --environment production",
    "ios": "expo run:ios",
    "testflight": "eas build --platform ios --profile production --auto-submit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:",
    "@repo/api": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/notes": "workspace:*",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-file-system": "catalog:",
    "expo-network": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-updates": "catalog:",
    "react": "catalog:expo",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expo/plist": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eas-cli": "catalog:",
    "typescript": "catalog:expo",
    "vitest": "catalog:"
  }
}
