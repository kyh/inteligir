{
  "name": "@repo/mobile",
  "version": "0.6.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    "./editor/item-ports": "./src/editor/item-ports.ts",
    "./items/phone-saves": "./src/items/phone-saves.ts",
    "./items/share-save": "./src/items/share-save.ts",
    "./lib/compose-runtime": "./src/lib/compose-runtime.ts",
    "./lib/node-replica-sql": "./src/lib/node-replica-sql.ts",
    "./test-support/memory-folders": "./src/test-support/memory-folders.ts"
  },
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform ios --output-dir dist",
    "editor-page": "pnpm --filter @repo/mobile-editor build",
    "eas-build-post-install": "pnpm run editor-page",
    "hotfix": "pnpm run editor-page && EXPO_PUBLIC_CLOUD_URL= eas update --channel production --platform ios --environment production",
    "ios": "pnpm run editor-page && expo run:ios",
    "testflight": "pnpm run editor-page && eas build --platform ios --profile production --auto-submit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@repo/agent-panel": "workspace:*",
    "@repo/contract": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/editor-bridge": "workspace:*",
    "@repo/library-replica": "workspace:*",
    "@repo/mobile-editor": "workspace:*",
    "@repo/notes": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-file-system": "catalog:",
    "expo-image-manipulator": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-linking": "catalog:",
    "expo-network": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-share-intent": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-updates": "catalog:",
    "nativewind": "catalog:",
    "react": "catalog:expo",
    "react-native": "catalog:",
    "react-native-css": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-webview": "catalog:",
    "react-native-worklets": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expo/plist": "catalog:",
    "@kyh/tsconfig": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eas-cli": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:expo",
    "vitest": "catalog:"
  }
}
