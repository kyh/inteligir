{
  "name": "@repo/mobile",
  "version": "0.7.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform ios --output-dir dist",
    "hotfix": "EXPO_NO_BUNDLE_SPLITTING=1 EXPO_PUBLIC_CLOUD_URL= eas update --channel production --platform ios --environment production",
    "ios": "expo run:ios",
    "testflight": "eas build --platform ios --profile production --auto-submit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
