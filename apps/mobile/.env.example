# Mobile (Expo) environment. Copy to `.env` (gitignored) only if you need to
# override the auto-detected server host. EXPO_PUBLIC_* vars are inlined into
# the JS bundle at build time — never put secrets here.

# Host[:port] of the @repo/server relay the app pairs/chats through.
# Leave UNSET in normal dev: the app derives it from the Expo dev server's
# host (Constants.expoConfig.hostUri) and talks to your local `wrangler dev`
# on port 8787. Set this only when auto-detection can't reach your machine —
# e.g. a physical device on another network, or a custom host. Production
# builds ignore it and use the deployed Worker.
# Example: EXPO_PUBLIC_SERVER_HOST=192.168.1.42:8787
EXPO_PUBLIC_SERVER_HOST=
