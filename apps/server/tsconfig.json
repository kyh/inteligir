{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // bin/inteligir.js imports the TS entry directly (tsx runs it pre-publish).
    "allowImportingTsExtensions": true,
    "paths": {
      "@repo/features/*": ["../../packages/features/src/*"],
      "@repo/host/*": ["../../packages/host/src/*"],
      "@repo/pi-driver/*": ["../../packages/pi-driver/src/*"],
      "@repo/agent-runtime/*": ["../../packages/agent-runtime/src/*"]
    }
  },
  "include": [
    "src",
    "bin",
    "vitest.config.ts",
    "../../packages/host/src/voice/sherpa-onnx-node.d.ts"
  ]
}
