{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.config.json"
  },
  "include": ["vite.config.ts", "vitest.config.ts"],
  // `src` is the page and its suites (src/tsconfig.json, and tsconfig.page.json at the browser's
  // stdlib): they type-check against the DOM and React rather than @types/node. `pnpm typecheck`
  // runs all three.
  "exclude": ["node_modules", "dist", "src"]
}
