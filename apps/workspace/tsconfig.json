{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.config.json"
  },
  "include": ["vite.config.ts", "vitest.config.ts"],
  // `src` is the page and its suites (src/tsconfig.json, and tsconfig.page.json at the window's
  // stdlib): they type-check against the DOM and React rather than @types/node. `scripts` is a
  // program of its own (scripts/tsconfig.json), resolved as node runs it. `pnpm typecheck` runs
  // all four.
  "exclude": ["node_modules", "dist", "scripts", "src"]
}
