{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // the flows boot the app's build output and load the extension's dev build
    "e2e": {
      "dependsOn": ["@repo/web#build", "@repo/extension#build"],
      "cache": false
    },
    // the same flows in Playwright's other engines, which load no extension
    "e2e:firefox": {
      "dependsOn": ["@repo/web#build"],
      "cache": false
    },
    "e2e:webkit": {
      "dependsOn": ["@repo/web#build"],
      "cache": false
    },
    // the phone's flows install its simulator build, whose cloud they listen as; Maestro runs on
    // the Java JAVA_HOME names
    "e2e:mobile": {
      "dependsOn": ["@repo/web#build", "@repo/mobile#simulator"],
      "cache": false,
      "passThroughEnv": ["EXPO_PUBLIC_CLOUD_URL", "JAVA_HOME"]
    }
  }
}
