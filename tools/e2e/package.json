{
  "name": "@repo/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright flows over the built app, one next start per worker on its own database, the extension and the phone's simulator build, deliberately outside `pnpm verify`: run them with `pnpm e2e`.",
  "type": "module",
  "scripts": {
    "e2e": "dotenv -e ../../.env.local -e ../../.env -- playwright test --project=chromium",
    "e2e:firefox": "dotenv -e ../../.env.local -e ../../.env -- playwright test --project=firefox",
    "e2e:mobile": "dotenv -e ../../.env.local -e ../../.env -- playwright test --config=playwright.phone.config.ts",
    "e2e:webkit": "dotenv -e ../../.env.local -e ../../.env -- playwright test --project=webkit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@orpc/client": "catalog:",
    "@playwright/test": "catalog:",
    "@repo/contract": "workspace:*",
    "@repo/db": "workspace:*",
    "@types/node": "catalog:",
    "@zip.js/zip.js": "^2.25.0",
    "dotenv-cli": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
