{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    // the scripted Messages API the harness serves names its imports by their `.ts`, as node runs
    // it (tools/messages-fake/tsconfig.json)
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vitest.config.ts"]
}
