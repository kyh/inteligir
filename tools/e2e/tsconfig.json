{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // the harness derives its deadlines from apps/cli's server modules, which target ES2024.
    "lib": ["ES2024"],
    "types": ["node"],
    // the scripted Messages API the harness serves names its imports by their `.ts`, as node runs
    // it (tools/messages-fake/tsconfig.json)
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
