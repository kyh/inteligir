{
  // node runs these files itself, stripping their types (`pnpm dev:web` starts src/main.ts), so
  // the program resolves as node does and refuses the syntax stripping cannot erase; the Worker's
  // suites bundle the same files, the fetch handler's web-standard code alone
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // node strips types and keeps the specifier, so an import names the `.ts` file it loads
    "allowImportingTsExtensions": true,
    // node keeps an import with no `type` keyword, so a type imported as a value throws at its
    // first run
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "vitest.config.ts"]
}
