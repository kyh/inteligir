# Copy to .env.production.local (gitignored — NEVER commit real values).
#
# Nothing in this file is needed for local development — the site and the
# Worker's local/test loops all run without it. It exists only for the
# OWNER-ONLY remote-D1 scripts in apps/web.
#
# Per-workspace env lives elsewhere:
# - apps/web/.dev.vars      — see apps/web/.dev.vars.example (local vite dev)

# --- Cloudflare D1 credentials (owner only) ----------------------------------
# Consumed by apps/web/drizzle.config.ts (driver: d1-http).
#
# DANGER: `pnpm -F @repo/web db:push` pushes the schema to the REMOTE
# production D1, and `db:studio` opens a read/WRITE UI over that same
# production database. The LOCAL push is `db:push:local`.
#
# CLOUDFLARE_D1_TOKEN = a Cloudflare API token with D1:Edit.
# CLOUDFLARE_DATABASE_ID = the id in apps/web/wrangler.jsonc -> d1_databases[0].
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
