# `cp .env.example .env` (gitignored): the app runs on it unedited. Every
# script reads `.env.local` first, then this file, and a shell variable beats
# both. Each key is one packages/service/src/env.ts parses, and its suite holds
# this file and turbo.json's globalEnv to that list. Production's values are the
# Vercel project's, and @repo/db's push:remote reads its database's from
# .env.production.local.

# Local Postgres, which `pnpm db:start` runs and writes to .env.local, whose line
# wins over this one. A direct connection; through a pooler, set
# POSTGRES_URL_NON_POOLING too, which drizzle-kit takes instead.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54622/postgres
# POSTGRES_URL_NON_POOLING=

# Better Auth's signing key: any 32 or more characters locally.
BETTER_AUTH_SECRET=local-only-better-auth-secret-0000000000

# The origin the app's links name; unset, the app derives one.
# APP_URL=https://inteligir.vercel.app

# The bearer Vercel Cron sends.
# CRON_SECRET=

# How mail goes: resend (with RESEND_API_KEY), log (to the server's log, reset
# links included) or off, the default.
EMAIL_MODE=log
# RESEND_API_KEY=

# The oldest phone or extension build the app answers, and each account's free
# storage in bytes; both default to these.
# MIN_CLIENT_BUILD=0.7.0
# LIBRARY_STORAGE_CAP_BYTES=1073741824

# Only while a script signs up several users: auth allows 10 requests/60s per IP.
# RATE_LIMIT_DISABLED=true
