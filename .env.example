# `cp .env.example .env` (gitignored): the app runs on it unedited. Every
# script reads `.env.local` first, then this file, and a shell variable beats
# both. Each key is one packages/service/src/env.ts parses, and its suite holds
# this file and turbo.json's globalEnv to that list. Production's values are the
# Vercel project's, and @repo/db's push:remote reads its database's from
# .env.production.local.

# Local Postgres, which `pnpm db:start` runs and writes to .env.local, whose line
# wins over this one. A direct connection; through a pooler, set
# POSTGRES_URL_NON_POOLING too, which drizzle-kit takes instead.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54622/postgres
# POSTGRES_URL_NON_POOLING=

# Better Auth's signing key: any 32 or more characters locally.
BETTER_AUTH_SECRET=local-only-better-auth-secret-0000000000

# The origin the app's links name; unset, the app derives one.
# APP_URL=https://inteligir.vercel.app

# The built-in agent's model through the AI Gateway, whose key it needs off
# Vercel. Unset, the agent is unavailable unless AGENT_MOCK_MODEL=true has it
# answer from a mock model that runs the directives `call <tool> <json>` and
# `long <chars>`, never on a deployment.
# AI_GATEWAY_API_KEY=
AGENT_MOCK_MODEL=true

# The bearer Vercel Cron sends.
# CRON_SECRET=

# Where files are kept. Vercel sets the Blob store's key on a project the store
# is connected to; without one, a server off Vercel keeps them in this folder,
# from its working folder (apps/web for pnpm dev:web), and sends uploads to its
# own /api/dev/files.
# BLOB_READ_WRITE_TOKEN=
# FILE_STORE_DIR=.data/files

# How mail goes: resend (with RESEND_API_KEY and EMAIL_FROM), log (to the
# server's log, reset links included) or off. Unset, production sends nothing
# and anywhere else logs.
EMAIL_MODE=log
# RESEND_API_KEY=
# The sender, on a domain Resend has verified.
# EMAIL_FROM=inteligir <no-reply@example.com>

# The oldest phone or extension build the app answers, and each account's free
# storage in bytes; both default to these.
# MIN_CLIENT_BUILD=0.7.0
# LIBRARY_STORAGE_CAP_BYTES=1073741824

# The e2e's stand-in for the web, which the app asks for an assistant's
# metadata document; never taken on Vercel.
# PAGE_FETCH_RELAY_URL=http://127.0.0.1:4100

# An eve server the app reaches its agent at, in place of its own /eve/v1; the
# e2e runs one per worker. Never taken on Vercel.
# EVE_BASE_URL=http://127.0.0.1:4275

# Only while a script signs up several users or loops on /v1: auth allows 10
# requests/60s per IP, and /v1 1,200 calls a minute per session.
# RATE_LIMIT_DISABLED=true
