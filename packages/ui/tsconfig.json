{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // Safari 16.4's stdlib: Vite lowers syntax, never stdlib
    "lib": ["ES2023", "dom", "dom.iterable"],
    // not init's `preserve`: both consumers check these sources under react-jsx
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src", "vitest.config.ts"]
}
