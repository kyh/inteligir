{
  "extends": "@kyh/tsconfig/internal-package.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "preserve",
    "noUncheckedIndexedAccess": false,
    "checkJs": false,
    "paths": {
      "@repo/ui/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
