    "@repo/notes": "workspace:*",
    "defuddle": "catalog:",
    "linkedom": "0.18.13",
    "turndown": "^7.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@types/turndown": "^5.0.6",
