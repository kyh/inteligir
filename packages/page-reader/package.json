{
  "name": "@repo/page-reader",
  "version": "0.1.0",
  "private": true,
  "description": "A saved page read into an item: its facts, and its article read as a tree into the library's article blocks, over linkedom. One reading for everything that fills a link: the cloud's fill and the extension's worker.",
  "type": "module",
  "exports": {
    "./page-facts": "./src/page-facts.ts",
    "./read-html": {
      "types": "./src/read-html-api.ts",
      "default": "./src/read-html.ts"
    },
    "./test-support/corpus/*": "./src/test-support/corpus/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/contract": "workspace:*",
    "@repo/editor": "workspace:*",
    "defuddle": "catalog:",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-mdast": "^10.1.4",
    "linkedom": "0.18.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/hast": "^3.0.5",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
