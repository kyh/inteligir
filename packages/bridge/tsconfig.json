{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // lib: ES2023 is a ceiling here, not just a floor — the RN companion loads
    // this package, and Hermes ships no ES2024+ stdlib (facebook/hermes#1684).
    // Raising it compiles clean and crashes on device.
    "lib": ["ES2023", "dom"],
    "types": [],
    "paths": {
      "@repo/bridge/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}
