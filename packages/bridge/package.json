{
  "name": "@repo/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "The isomorphic wire contract between clients and the host: the Bridge/IPC registry (TypeBox channel schemas → the transport-agnostic Bridge type), the ws client + protocol, the agent grant table, and the shared domain schemas (chat log, delegation, deep links, account state…). Loads in the browser workspace, React Native and workerd alike — no node/electron/react imports, ever; that boundary is a package fact (this package's deps are @repo/notes + typebox only).",
  "type": "module",
  "exports": {
    "./__tests__/chat-log-fixtures": "./src/__tests__/chat-log-fixtures.ts",
    "./agent-event-parser": "./src/agent-event-parser.ts",
    "./agent-events": "./src/agent-events.ts",
    "./agent-grants": "./src/agent-grants.ts",
    "./agent-instructions": "./src/agent-instructions.ts",
    "./ai-provider": "./src/ai-provider.ts",
    "./app-state": "./src/app-state.ts",
    "./backoff": "./src/backoff.ts",
    "./chat-log": "./src/chat-log.ts",
    "./chat-message": "./src/chat-message.ts",
    "./chat-sessions": "./src/chat-sessions.ts",
    "./client": "./src/client.ts",
    "./daily-notes": "./src/daily-notes.ts",
    "./deep-link": "./src/deep-link.ts",
    "./delegation": "./src/delegation.ts",
    "./inline-ai": "./src/inline-ai.ts",
    "./ipc-registry": "./src/ipc-registry.ts",
    "./note-context": "./src/note-context.ts",
    "./routine-schedule": "./src/routine-schedule.ts",
    "./routines": "./src/routines.ts",
    "./ui-state": "./src/ui-state.ts",
    "./voice": "./src/voice.ts",
    "./wire-helpers": "./src/wire-helpers.ts",
    "./ws-bridge": "./src/ws-bridge.ts",
    "./ws-protocol": "./src/ws-protocol.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@repo/notes": "workspace:*",
    "@sinclair/typebox": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
