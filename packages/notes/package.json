    "./knowledge/doc-file": "./src/knowledge/doc-file.ts",
    "./knowledge/vault-path": "./src/knowledge/vault-path.ts",
    "./knowledge/link-extract": "./src/knowledge/link-extract.ts",
    "./knowledge/link-resolve": "./src/knowledge/link-resolve.ts",
    "./knowledge/note-name": "./src/knowledge/note-name.ts",
    "./knowledge/rename-links": "./src/knowledge/rename-links.ts",
    "./knowledge/projection": "./src/knowledge/projection.ts",
    "./knowledge/find-task-line": "./src/knowledge/find-task-line.ts",
    "./knowledge/guarded-line-edit": "./src/knowledge/guarded-line-edit.ts",
    "./knowledge/task-schedule": "./src/knowledge/task-schedule.ts",
    "./knowledge/link-graph-index": "./src/knowledge/link-graph-index.ts",
    "./knowledge/tag-index": "./src/knowledge/tag-index.ts",
    "./knowledge/knowledge-store": "./src/knowledge/knowledge-store.ts",
    "./knowledge/sql-knowledge-store": "./src/knowledge/sql-knowledge-store.ts",
    "./knowledge/knowledge-index": "./src/knowledge/knowledge-index.ts",
    "./knowledge/related-notes": "./src/knowledge/related-notes.ts",
    "./knowledge/vault-search": "./src/knowledge/vault-search.ts",
    "./markdown/remark-wiki-link": "./src/markdown/remark-wiki-link.ts",
