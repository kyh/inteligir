{
  "name": "@repo/notes",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, platform-agnostic domain core. ZERO node/react/fs/dom deps, so the same code runs in the local server, in the browser and on a Worker. `src/knowledge/` is the link graph, search and projection engine over a vault; `src/markdown/` is the one markdown scan it reads, plus frontmatter and the delegation marker. No I/O, no clock, no crypto — the caller injects them.",
  "type": "module",
  "exports": {
    "./daily-path": "./src/daily-path.ts",
    "./text/line-diff": "./src/text/line-diff.ts",
    "./text/diff3": "./src/text/diff3.ts",
    "./text/hunk-merge": "./src/text/hunk-merge.ts",
    "./knowledge/doc-file": "./src/knowledge/doc-file.ts",
    "./knowledge/vault-path": "./src/knowledge/vault-path.ts",
    "./knowledge/link-extract": "./src/knowledge/link-extract.ts",
    "./knowledge/link-resolve": "./src/knowledge/link-resolve.ts",
    "./knowledge/note-name": "./src/knowledge/note-name.ts",
    "./knowledge/rename-candidates": "./src/knowledge/rename-candidates.ts",
    "./knowledge/rename-links": "./src/knowledge/rename-links.ts",
    "./knowledge/projection": "./src/knowledge/projection.ts",
    "./knowledge/task-ordinal": "./src/knowledge/task-ordinal.ts",
    "./knowledge/source-lines": "./src/knowledge/source-lines.ts",
    "./knowledge/link-graph-index": "./src/knowledge/link-graph-index.ts",
    "./knowledge/tag-index": "./src/knowledge/tag-index.ts",
    "./knowledge/knowledge-store": "./src/knowledge/knowledge-store.ts",
    "./knowledge/sql-knowledge-store": "./src/knowledge/sql-knowledge-store.ts",
    "./knowledge/knowledge-index": "./src/knowledge/knowledge-index.ts",
    "./knowledge/related-notes": "./src/knowledge/related-notes.ts",
    "./knowledge/vault-search": "./src/knowledge/vault-search.ts",
    "./markdown/remark-wiki-link": "./src/markdown/remark-wiki-link.ts",
    "./markdown/frontmatter": "./src/markdown/frontmatter.ts",
    "./markdown/thread-marker": "./src/markdown/thread-marker.ts",
    "./markdown/thread-anchor": "./src/markdown/thread-anchor.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "mdast-util-to-markdown": "^2.1.2",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "unified": "catalog:",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdast": "catalog:",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-util-types": "^2.0.2",
    "remark-stringify": "^11.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
