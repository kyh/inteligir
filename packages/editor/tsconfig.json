{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Same ES2023 floor-and-ceiling as @repo/ui, and for the same reason: this
    // package is bundled into apps/web at Vite's `baseline-widely-available`
    // target, which transforms syntax but never stdlib.
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    // node: the roundtrip fixture matrix is read off disk by the markdown tests.
    "types": ["node"],
    "paths": {
      "@repo/editor/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}
