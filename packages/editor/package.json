{
  "name": "@repo/editor",
  "version": "0.1.0",
  "private": true,
  "description": "CodeMirror 6 markdown live-preview editor (Obsidian model: the buffer IS the file; syntax marks hide except near the selection). Vendors @prosemark/core (MIT, pinned in src/vendor/prosemark/PROVENANCE.md) and layers the house surface on top: heading hashes hung in the left margin, interactive task checkboxes, drag-freeze, viewport force-parse healing, and a CSS custom-property theme the app's appearance system can drive.",
  "type": "module",
  "exports": {
    "./create-markdown-editor": "./src/create-markdown-editor.ts",
    "./external-replace": "./src/external-replace.ts",
    "./editor-theme": "./src/editor-theme.ts",
    "./react/markdown-editor": "./src/react/markdown-editor.tsx",
    "./test-support/jsdom-stubs": "./src/test-support/jsdom-stubs.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "vite serve dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@lezer/yaml": "^1.0.4",
    "@repo/notes": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "jsdom": "^30.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
