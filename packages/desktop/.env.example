# Copy to packages/desktop/.env (gitignored — NEVER commit real values).
#
# How it's loaded:
# - Dev: `pnpm dev:desktop` — src/main/index.ts loads this file into
#   process.env at startup (process.loadEnvFile). electron-vite itself does
#   not dotenv-load it, so shell exports also work.
# - Release: `release` / `release:publish` run under `pnpm with-env`
#   (dotenv -e .env), so build-time `define` injection and electron-builder
#   notarization both see these.

# --- Bundled Google OAuth client (optional) ---------------------------------
# Baked into the main bundle at build time so end users connect Google
# without pasting their own GCP app. Must be a Google "Desktop app" type
# OAuth client — its secret is non-confidential by Google's installed-app
# spec (RFC 8252), so bundling it is Google's documented model. Leave empty
# to ship without one (users get the paste-your-own-GCP-client dialog).
# Desktop clients accept any localhost redirect; the daemon's callback is
# http://localhost:47888/api/oauth/callback.
INTELIGIR_GOOGLE_OAUTH_CLIENT_ID=
INTELIGIR_GOOGLE_OAUTH_CLIENT_SECRET=

# --- Voice (dev, optional) ---------------------------------------------------
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Apple notarization (release builds, required) ---------------------------
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
