{
  "name": "@repo/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, platform-agnostic domain core. ZERO node/react/fs/dom deps so it runs unchanged in a Cloudflare Worker (future sync coordinator), React Native (future mobile client), and the desktop renderer. `src/sync/` is the vault-sync protocol: wire types + the pure last-write-wins/conflict-copy reconcile brain. No I/O, no clock, no crypto — the caller supplies hashes + timestamps.",
  "type": "module",
  "exports": {
    "./sync/vault-file": "./src/sync/vault-file.ts",
    "./sync/manifest": "./src/sync/manifest.ts",
    "./sync/sync-port": "./src/sync/sync-port.ts",
    "./sync/plan": "./src/sync/plan.ts",
    "./sync/reconcile": "./src/sync/reconcile.ts",
    "./sync/wire": "./src/sync/wire.ts",
    "./sync/guards": "./src/sync/guards.ts",
    "./sync/base-store": "./src/sync/base-store.ts",
    "./sync/engine": "./src/sync/engine.ts",
    "./sync/http-sync-port": "./src/sync/http-sync-port.ts",
    "./knowledge/doc-file": "./src/knowledge/doc-file.ts",
    "./knowledge/vault-path": "./src/knowledge/vault-path.ts",
    "./knowledge/link-resolve": "./src/knowledge/link-resolve.ts",
    "./knowledge/rename-links": "./src/knowledge/rename-links.ts",
    "./knowledge/knowledge-index": "./src/knowledge/knowledge-index.ts",
    "./markdown/remark-wiki-link": "./src/markdown/remark-wiki-link.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-util-types": "^2.0.2",
    "remark-stringify": "^11.0.0",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  }
}
