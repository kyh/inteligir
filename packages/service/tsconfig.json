{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // the generated types are in `include`: other tools read a relative `types` path as a package
    "types": ["@cloudflare/vitest-plugin/types"],
    // highlight.js's declarations would load the DOM's lib into a workerd program
    "paths": {
      "highlight.js": ["./src/types/highlight-js.d.ts"]
    },
    // the configs import the config modules by their `.ts`, as node loads them
    "allowImportingTsExtensions": true
  },
  "include": [".", ".cloudflare/types/index.d.ts"],
  // scripts/ is node's own program
  "exclude": ["node_modules", "scripts"]
}
