{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // No DOM: this code runs on workerd, typed by the runtime `cf workers types` generates from the
    // suites' Worker (cloudflare.config.ts), whose globals (Request, BufferSource, crypto) are the
    // ones that must win. That Env is the suites'; apps/web/src/worker/tsconfig.json checks every
    // module its entry reaches against the deployed one.
    "lib": ["ES2023"],
    // the generated types are listed in `include`, not here: a relative path in `types` reads as a
    // package name to anything that resolves this config without tsc's rules
    "types": ["@cloudflare/vitest-plugin/types"],
    // highlight.js's declarations would load the DOM's lib into this program, so they are mapped to
    // the one type the editor's code block reaches them for (src/types/highlight-js.d.ts)
    "paths": {
      "highlight.js": ["./src/types/highlight-js.d.ts"]
    },
    // cloudflare.config.ts and vitest.config.ts name the config modules by their `.ts`, as node
    // loads them
    "allowImportingTsExtensions": true
  },
  "include": [".", ".cloudflare/types/index.d.ts"],
  // scripts/ is node's own program (scripts/tsconfig.json)
  "exclude": ["node_modules", "scripts"]
}
