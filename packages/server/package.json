{
  "name": "@repo/server",
  "version": "0.1.0",
  "private": true,
  "description": "The Inteligir node backend behind createHost(): vault, delegation, connectors daemon, voice, sync adapters, knowledge host shell, transport (ws host), and the boot/ composition root that wires @repo/agent capabilities. Node-only — the iso wire contract lives in @repo/bridge. Exports are NARROW on purpose: exactly the entrypoints the desktop main process composes; everything else is package-private.",
  "type": "module",
  "exports": {
    "./server/boot/create-host": "./src/server/boot/create-host.ts",
    "./server/capture/deep-link-service": "./src/server/capture/deep-link-service.ts",
    "./server/knowledge/sqlite-knowledge-store": "./src/server/knowledge/sqlite-knowledge-store.ts",
    "./server/platform": "./src/server/platform.ts",
    "./server/transport/remote-access-manager": "./src/server/transport/remote-access-manager.ts",
    "./server/transport/ws-host": "./src/server/transport/ws-host.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@repo/agent": "workspace:*",
    "@repo/bridge": "workspace:*",
    "@repo/connectors": "workspace:*",
    "@repo/notes": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/vault": "workspace:*",
    "@repo/voice": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "better-auth": "catalog:",
    "open": "^11.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
