{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    // drizzle-kit loads the configs under node; the schemas and the client name no platform
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src",
    "drizzle.config.ts",
    "drizzle.config.local.ts",
    "drizzle.config.cell.ts",
    "drizzle.config.note.ts"
  ],
  // drizzle-kit's output, which imports each migration's SQL as a text module: the Worker's
  // programs that bundle it type that (packages/service/src/types/sql-modules.d.ts)
  "exclude": ["node_modules", "src/cell/migrations", "src/note/migrations"]
}
