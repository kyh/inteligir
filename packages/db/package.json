{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "description": "The local SQLite database: drizzle over better-sqlite3, its migrations and row writers.",
  "type": "module",
  "exports": {
    "./connection": "./src/connection.ts",
    "./events": "./src/events.ts",
    "./ids": "./src/ids.ts",
    "./meta": "./src/meta.ts",
    "./migrate": "./src/migrate.ts",
    "./pending-interactions": "./src/pending-interactions.ts",
    "./queued-messages": "./src/queued-messages.ts",
    "./sync-outbox": "./src/sync-outbox.ts",
    "./threads": "./src/threads.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/domain": "workspace:*",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
