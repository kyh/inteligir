{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres: Better Auth's tables, the invite codes, every account's library and the built-in agent's threads, the client over POSTGRES_URL, the drizzle-kit push of its schema and the extensions it leans on, local Supabase, and the throwaway databases the suites and the e2e flows run on.",
  "type": "module",
  "exports": {
    "./agent-schema": "./src/agent-schema.ts",
    "./auth-schema": "./src/auth-schema.ts",
    "./drizzle-client": "./src/drizzle-client.ts",
    "./library-schema": "./src/library-schema.ts",
    "./run-databases": "./src/run-databases.ts",
    "./test-database": "./src/test-database.ts",
    "./test-database-file": "./src/test-database-file.ts"
  },
  "scripts": {
    "push": "pnpm with-env node scripts/push.ts",
    "push:check": "pnpm with-env node scripts/check-push.ts",
    "push:remote": "dotenv -e ../../.env.production.local -- node scripts/push.ts",
    "reset": "(pnpm --silent status || pnpm start) && pnpm with-env node scripts/reset.ts",
    "start": "supabase start --runtime native && supabase status --env --output-format text --override-name DB_URL=POSTGRES_URL > ../../.env.local",
    "status": "pnpm with-env node scripts/status.ts",
    "stop": "supabase stop",
    "studio": "pnpm with-env drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "with-env": "dotenv -e ../../.env.local -e ../../.env --"
  },
  "dependencies": {
    "@repo/contract": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "catalog:",
    "supabase": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
