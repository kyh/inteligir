{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "description": "The D1 accounts database's, each library cell's, each note's and each conversation's drizzle schemas, the D1 client, each object's DDL as drizzle-kit exports it, and the drizzle-kit configs that push D1.",
  "type": "module",
  "exports": {
    "./cell/ddl.sql": "./src/cell/ddl.sql",
    "./cell/schema": "./src/cell/schema.ts",
    "./d1/client": "./src/d1/client.ts",
    "./d1/schema": "./src/d1/schema.ts",
    "./note/ddl.sql": "./src/note/ddl.sql",
    "./note/schema": "./src/note/schema.ts",
    "./thread/ddl.sql": "./src/thread/ddl.sql",
    "./thread/schema": "./src/thread/schema.ts"
  },
  "scripts": {
    "ddl": "node scripts/object-ddl.ts",
    "export": "drizzle-kit export --dialect=sqlite --schema=./src/d1/schema.ts",
    "push": "drizzle-kit push --config drizzle.config.local.ts --force",
    "push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "studio": "drizzle-kit studio --config drizzle.config.local.ts",
    "studio:remote": "dotenv -e ../../.env.production.local -- drizzle-kit studio",
    "test": "node scripts/object-ddl.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/contract": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@libsql/client": "^0.18.0",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
