{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "supabase": "pnpm with-env supabase",
    "drizzle:kit": "pnpm with-env drizzle-kit",
    "seed": "pnpm with-env tsx src/seed/initial.ts",
    "start": "pnpm with-env supabase status || supabase start",
    "stop": "pnpm with-env supabase stop",
    "reset": "pnpm with-env supabase db reset && pnpm push",
    "status": "pnpm with-env supabase status",
    "typegen": "pnpm with-env supabase gen types typescript --local > src/database.types.ts",
    "push": "pnpm with-env drizzle-kit push",
    "push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "with-env": "dotenv -e ../../.env --",
    "generate:auth-schema": "pnpm with-env pnpx @better-auth/cli generate --config ../api/src/auth/auth.ts --output ./src/drizzle-schema-auth.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "drizzle-orm": "^0.45.2",
    "next": "catalog:",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@kyh/tsconfig": "catalog:",
    "@types/react": "catalog:",
    "drizzle-kit": "^0.31.10",
    "supabase": "^2.101.0",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  }
}
