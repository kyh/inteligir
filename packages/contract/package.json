{
  "name": "@repo/contract",
  "version": "0.1.0",
  "private": true,
  "description": "ONE contract package, TWO entry points. `./local` is the desktop renderer and the CLI talking to the local server; `./cloud` is the local server and mobile talking to the Worker. Separate entry points because their compatibility obligations are opposite: /local's two ends ship in one bundle and may break freely, /cloud is a deployed Worker answering installs that may be months stale.",
  "type": "module",
  "exports": {
    "./cloud/account/account-schema": "./src/cloud/account/account-schema.ts",
    "./cloud/bytes": "./src/cloud/bytes.ts",
    "./cloud/client": "./src/cloud/cloud-client.ts",
    "./cloud/device/device-schema": "./src/cloud/device/device-schema.ts",
    "./cloud/dispatch/dispatch-schema": "./src/cloud/dispatch/dispatch-schema.ts",
    "./cloud/device/login-flow": "./src/cloud/device/login-flow.ts",
    "./cloud/errors": "./src/cloud/cloud-errors.ts",
    "./cloud/origin": "./src/cloud/cloud-origin.ts",
    "./cloud/sync/cloud-socket": "./src/cloud/sync/cloud-socket.ts",
    "./cloud/sync/fit-sync-event": "./src/cloud/sync/fit-sync-event.ts",
    "./cloud/sync/plan-page": "./src/cloud/sync/plan-page.ts",
    "./cloud/sync/socket-link": "./src/cloud/sync/socket-link.ts",
    "./cloud/sync/sync-session": "./src/cloud/sync/sync-session.ts",
    "./cloud/sync/sync-schema": "./src/cloud/sync/sync-schema.ts",
    "./cloud/sync/sync-ws": "./src/cloud/sync/sync-ws.ts",
    "./cloud/test-support/fake-cloud-client": "./src/cloud/test-support/fake-cloud-client.ts",
    "./local": "./src/local/local-contract.ts",
    "./local/build-thread-timeline": "./src/local/build-thread-timeline.ts",
    "./local/cloud/cloud-schema": "./src/local/cloud/cloud-schema.ts",
    "./local/errors": "./src/local/local-errors.ts",
    "./local/notifications": "./src/local/notifications.ts",
    "./local/routes": "./src/local/local-routes.ts",
    "./local/system/system-schema": "./src/local/system/system-schema.ts",
    "./local/thread-timeline": "./src/local/thread-timeline.ts",
    "./local/threads/threads-schema": "./src/local/threads/threads-schema.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@repo/domain": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
