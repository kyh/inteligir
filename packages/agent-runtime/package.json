{
  "name": "@repo/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "The ACP agent runtime: one adapter speaks Zed's agent-client-protocol to claude-code-acp and codex-acp children; harnesses are data rows, and events translate into the runtime's own provider grammar. Consumers say \"start a session, run a turn, give me events\" — they never touch processes or wire formats.",
  "type": "module",
  "exports": {
    "./acp/acp-event-mapping": "./src/acp/acp-event-mapping.ts",
    "./acp/acp-permission-mapping": "./src/acp/acp-permission-mapping.ts",
    "./acp/acp-runtime": "./src/acp/acp-runtime.ts",
    "./acp/harness-registry": "./src/acp/harness-registry.ts",
    "./types": "./src/types.ts",
    "./vocabulary/provider-event": "./src/vocabulary/provider-event.ts",
    "./test-support/fake-acp-agent": "./src/test-support/fake-acp-agent.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/domain": "workspace:*",
    "@zed-industries/agent-client-protocol": "0.4.5",
    "@zed-industries/claude-code-acp": "catalog:",
    "@zed-industries/codex-acp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
