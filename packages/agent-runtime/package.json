{
  "name": "@repo/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Filesystem bootstrap for Inteligir desktop: resource seeding, gws, and agent-browser installation.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
