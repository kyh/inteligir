{
  "name": "@repo/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "The ACP agent runtime: one adapter speaks the Agent Client Protocol to claude-agent-acp and codex-acp children; harnesses are data rows, and events translate into the runtime's own provider grammar. Consumers say \"start a session, run a turn, give me events\" — they never touch processes or wire formats.",
  "type": "module",
  "exports": {
    "./acp/acp-runtime": "./src/acp/acp-runtime.ts",
    "./acp/acp-sign-in": "./src/acp/acp-sign-in.ts",
    "./acp/harness-registry": "./src/acp/harness-registry.ts",
    "./acp/provider-error": "./src/acp/provider-error.ts",
    "./types": "./src/types.ts",
    "./vocabulary/provider-event": "./src/vocabulary/provider-event.ts",
    "./test-support/fake-acp-agent": "./src/test-support/fake-acp-agent.mjs"
  },
  "scripts": {
    "record:transcripts": "tsx scripts/record-acp-transcripts.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@agentclientprotocol/codex-acp": "catalog:",
    "@agentclientprotocol/sdk": "catalog:",
    "@repo/domain": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
