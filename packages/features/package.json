{
  "name": "@repo/features",
  "version": "0.1.0",
  "private": true,
  "description": "The Inteligir backend + isomorphic contract. `src/` (browser-safe) holds the Bridge/IPC registry and domain schemas; `src/server/` is the node backend (vault, pi agent, delegation, connectors, voice, sync adapters, handlers) behind createHost(). The pure domain (knowledge, markdown, sync engine) lives in @repo/domain. Consumed by the desktop renderer (iso) and main (server).",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@repo/domain": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "better-auth": "catalog:",
    "ignore": "^7.0.5",
    "open": "^11.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sherpa-onnx-node": "^1.13.4",
    "tar": "^7.5.19",
    "unbzip2-stream": "^1.4.3",
    "unified": "^11.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/ws": "^8.18.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
