{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // dom: this package is isomorphic — its pure logic loads in the Electron
    // renderer (a browser context) as well as the node host. Stays free of
    // *node* types by design.
    "lib": ["ES2023", "dom"],
    "paths": {
      "@repo/features/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}
