{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web (vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/apps/web",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "name": "Server (cli serve)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm cli serve",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ]
}
